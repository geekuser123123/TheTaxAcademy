---
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import '../styles/portal.css';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/icons';
import { isTeam } from '../lib/auth';
import { site } from '../data/site';

interface Props {
  title: string;
  bare?: boolean; // sign-in style pages without the sidebar
}

const { title, bare = false } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname.replace(/\/$/, '');

const clientNav: { href: string; label: string; icon: IconName }[] = [
  { href: '/portal', label: 'Overview', icon: 'layoutDashboard' },
  { href: '/portal/documents', label: 'Documents', icon: 'folder' },
  { href: '/portal/messages', label: 'Messages', icon: 'messageCircle' },
  { href: '/portal/requests', label: 'My requests', icon: 'inbox' },
  { href: '/portal/account', label: 'Account', icon: 'keyRound' },
];
const teamNav: { href: string; label: string; icon: IconName }[] = [
  { href: '/portal/admin', label: 'Clients', icon: 'users' },
  { href: '/portal/admin/submissions', label: 'Form requests', icon: 'inbox' },
  { href: '/portal/account', label: 'Account', icon: 'keyRound' },
];
const nav = isTeam(user) ? teamNav : clientNav;
const active = (href: string) =>
  href === '/portal' || href === '/portal/admin' ? path === href || (href === '/portal/admin' && path.startsWith('/portal/admin/clients')) : path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | {site.name} client portal</title>
    <meta name="theme-color" content="#001d21" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body class="portal-body">
    {
      bare ? (
        <main class="auth-shell">
          <div class="auth-side on-dark">
            <a href="/" class="auth-brand">
              <img src="/images/seal.png" alt="" width="56" height="56" />
              <span>{site.legalName}</span>
            </a>
            <div>
              <span class="eyebrow">Client portal</span>
              <h1>Your documents, messages, and ongoing work.</h1>
              <p>Private and secure. Need a form instead? Every form works without signing in.</p>
              <a href="/forms" class="text-link">
                Go to forms
                <Icon name="arrowRight" size={16} />
              </a>
            </div>
            <p class="auth-foot">
              Trouble signing in? Call <a href={site.phoneHref}>{site.phone}</a>
            </p>
          </div>
          <div class="auth-main">
            <slot />
          </div>
        </main>
      ) : (
        <div class="portal-shell">
          <aside class="portal-side on-dark">
            <a href="/" class="portal-brand">
              <img src="/images/seal.png" alt="" width="40" height="40" />
              <span>
                {site.name}
                <small>{isTeam(user) ? 'Team workspace' : 'Client portal'}</small>
              </span>
            </a>
            <nav aria-label="Portal navigation">
              {nav.map((item) => (
                <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>
                  <Icon name={item.icon} size={18} />
                  {item.label}
                </a>
              ))}
            </nav>
            <div class="portal-user">
              <div>
                <strong>{user?.name}</strong>
                <small>{user?.email}</small>
              </div>
              <form method="post" action="/portal/logout">
                <button type="submit" class="icon-button" aria-label="Sign out" title="Sign out">
                  <Icon name="logOut" size={18} />
                </button>
              </form>
            </div>
          </aside>
          <main class="portal-main" id="main">
            <slot />
          </main>
        </div>
      )
    }
  </body>
</html>
