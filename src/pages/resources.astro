---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import HelpBand from '../components/HelpBand.astro';
import { videos, videoLibraryUrl, guides } from '../data/resources';
---

<SiteLayout title="Guides & resources" description="Video insights and guides on self-directed 401(k)s, IRAs, and plan compliance.">
  <PageHero
    eyebrow="Resources"
    title="Guides and insights for plan owners."
    lede="Clear explanations of self-directed 401(k)s, rollovers, and alternative investments, so you can make informed decisions with confidence."
  />

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Guides</span>
          <h2>Start with the basics.</h2>
        </div>
      </div>
      <div class="grid-2">
        {
          guides.map((g) => (
            <a href={g.href} class="card guide">
              <Icon name="bookOpen" size={22} stroke={1.6} />
              <h3>{g.title}</h3>
              <p>{g.text}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="slant on-dark">
    <div class="container video-grid">
      <div class="video-intro">
        <span class="eyebrow">Videos</span>
        <h2>Video insights on self-directed IRAs & 401(k)s</h2>
        <p>
          Short videos explaining self-directed IRAs, 401(k)s, and compliant retirement strategies, to help you make
          informed decisions with confidence.
        </p>
        {videoLibraryUrl && <a href={videoLibraryUrl} class="button" style="margin-top:20px">See all videos<Icon name="external" size={16} /></a>}
      </div>
      {
        videos.map((v) =>
          v.youtubeId ? (
            <a class="video-card" href={`https://www.youtube.com/watch?v=${v.youtubeId}`} target="_blank" rel="noopener">
              <span class="video-thumb">
                <img src={`https://i.ytimg.com/vi/${v.youtubeId}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
                <span class="play"><Icon name="play" size={20} /></span>
              </span>
              <small>{v.presenter}</small>
              <strong>{v.title}</strong>
            </a>
          ) : (
            <div class="video-card is-soon">
              <span class="video-thumb">
                <img src="/images/seal.png" alt="" loading="lazy" width="80" height="80" class="seal" />
                <span class="soon">Coming soon</span>
              </span>
              <small>{v.presenter}</small>
              <strong>{v.title}</strong>
            </div>
          ),
        )
      }
    </div>
  </section>

  <Faq />
  <HelpBand />
</SiteLayout>

<style>
  .guide {
    display: grid;
    align-content: start;
    gap: 8px;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .guide:hover {
    background: var(--cream-2);
  }
  .guide :global(.icon) {
    color: var(--green);
    margin-bottom: 8px;
  }
  .video-grid {
    display: grid;
    grid-template-columns: 1.1fr repeat(3, 1fr);
    gap: 20px;
    align-items: start;
  }
  .video-intro h2 {
    font-size: 1.6rem;
    margin-bottom: 12px;
  }
  .video-intro p {
    color: var(--muted-on-dark);
    font-size: 0.95rem;
  }
  .video-card {
    display: grid;
    gap: 6px;
    padding: 10px 10px 18px;
    border-radius: 12px;
    background: #fff;
    color: var(--text);
    text-decoration: none;
  }
  .video-card small {
    padding: 8px 6px 0;
    color: var(--green);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .video-card strong {
    padding: 0 6px;
    line-height: 1.3;
  }
  .video-thumb {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--ink-3), var(--ink));
  }
  .video-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video-thumb .seal {
    width: 64px;
    height: 64px;
    opacity: 0.9;
  }
  .play {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 34px;
    border-radius: 8px;
    background: #e62117;
    color: #fff;
  }
  .soon {
    position: absolute;
    bottom: 8px;
    right: 8px;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
  }
  @media (max-width: 1020px) {
    .video-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .video-intro {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 620px) {
    .video-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
