---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import HelpBand from '../../components/HelpBand.astro';
import { serviceCategories, type ServiceCategory } from '../../data/services';

export function getStaticPaths() {
  return serviceCategories.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

const { category } = Astro.props as { category: ServiceCategory };
const others = serviceCategories.filter((c) => c.slug !== category.slug);
---

<SiteLayout title={category.title} description={category.summary}>
  <PageHero
    eyebrow="Explore services"
    title={category.title}
    lede={category.intro}
    crumbs={[{ href: '/services', label: 'Explore services' }]}
  >
    <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:32px">
      <a href="/forms/advanced-planning" class="button">Start a conversation<Icon name="arrowRight" size={17} /></a>
    </div>
  </PageHero>
  <section class="section">
    <div class="container">
      <div class="grid-2">
        {
          category.items.map((item) => (
            <div class="card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
      <div class="scope-note">
        <Icon name="clipboardCheck" size={22} />
        <p>
          <strong>Clear scope before new work.</strong> Advanced work is organized as a defined project. We bring in the right
          attorney or professional, and scope, fees, and next steps are agreed before anything begins.
        </p>
      </div>
    </div>
  </section>
  <section class="section" style="background:var(--cream); padding-top:64px">
    <div class="container">
      <h2 style="font-size:1.5rem; margin-bottom:24px">Other ways to use your plan</h2>
      <div class="grid-2 others">
        {
          others.map((c) => (
            <a href={`/services/${c.slug}`} class="card card-white">
              <Icon name={c.icon} size={22} stroke={1.6} />
              <span>
                <h3>{c.title}</h3>
                <p>{c.summary}</p>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <HelpBand />
</SiteLayout>

<style>
  .scope-note {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    margin-top: 32px;
    padding: 24px;
    border-left: 4px solid var(--lime);
    background: var(--cream);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .scope-note :global(.icon) {
    flex: none;
    color: var(--green);
    margin-top: 2px;
  }
  .scope-note p {
    color: var(--muted);
  }
  .scope-note strong {
    color: var(--text);
  }
  .others .card {
    display: flex;
    gap: 16px;
    text-decoration: none;
  }
  .others :global(.icon) {
    flex: none;
    color: var(--green);
    margin-top: 2px;
  }
  .others h3 {
    margin-bottom: 4px;
  }
</style>
