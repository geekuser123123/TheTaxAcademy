---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<SiteLayout title="Page not found">
  <PageHero
    eyebrow="Page not found"
    title="Let’s get you back on track."
    lede="The page may have moved. Choose where you’d like to go."
  >
    <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:32px">
      <a href="/" class="button">Home</a>
      <a href="/forms" class="button button-secondary">Forms & requests</a>
      <a href="/portal" class="button button-secondary">Client portal</a>
    </div>
  </PageHero>
</SiteLayout>
