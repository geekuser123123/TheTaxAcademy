---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<SiteLayout title="Page Not Found | The Tax Academy" noindex>
  <PageHero
    eyebrow="Page not found"
    title="Let’s get you back on track."
    lede="The page may have moved. Choose where you’d like to go."
  >
    <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:32px">
      <a href="/" class="button">Home</a>
      <a href="/renewal-page/" class="button button-secondary">Renew My Plan</a>
      <a href="/contact/" class="button button-secondary">Contact</a>
    </div>
  </PageHero>
</SiteLayout>
