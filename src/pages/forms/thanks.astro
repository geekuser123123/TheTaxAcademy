---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { site } from '../../data/site';
---

<SiteLayout title="Request received">
  <PageHero
    eyebrow="Request received"
    title="Thanks. We’ve got it."
    lede={`Your request is with the team. We’ll review it and reach out with the next step, usually within one business day. If it’s urgent, call us at ${site.phone}.`}
  >
    <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:32px">
      <a href="/" class="button">Back to home</a>
      <a href="/forms" class="button button-secondary">Another form</a>
    </div>
  </PageHero>
</SiteLayout>
