---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
---

<SiteLayout title="Request received">
  <section class="section">
    <div class="container thanks">
      <span class="icon-box"><Icon name="check" size={28} /></span>
      <h1>Thanks. We’ve got it.</h1>
      <p class="lede">
        Your request is with the team. We’ll review it and reach out with the next step, usually within one business day.
        If it’s urgent, call us at <a href={site.phoneHref}>{site.phone}</a>.
      </p>
      <div class="actions">
        <a href="/" class="button">Back to home</a>
        <a href="/forms" class="button button-secondary">Another form</a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .thanks {
    display: grid;
    justify-items: center;
    gap: 20px;
    max-width: 640px;
    text-align: center;
  }
  .thanks .icon-box {
    width: 72px;
    height: 72px;
    border-radius: 50%;
  }
  .thanks h1 {
    font-size: clamp(2rem, 4vw, 3rem);
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .button-secondary {
    color: var(--ink);
  }
</style>
