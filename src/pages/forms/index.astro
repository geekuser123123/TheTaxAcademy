---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FormRow from '../../components/FormRow.astro';
import HelpBand from '../../components/HelpBand.astro';
import { forms } from '../../data/forms';

const groups = [...new Set(forms.map((f) => f.group))];
---

<SiteLayout title="Forms & requests" description="Request documents, annual reporting help, plan amendments, loans, and renewals. No portal sign-in needed.">
  <PageHero
    eyebrow="Forms & requests"
    title="The forms you need,<br/>no sign-in required."
    lede="Pick the closest match. Each form takes a few minutes, and a real person on the team follows up with the next step."
  />
  <section class="section">
    <div class="container forms-index">
      {
        groups.map((g) => (
          <div class="forms-group">
            <h2>{g}</h2>
            <div class="row-list">
              {forms.filter((f) => f.group === g).map((f) => <FormRow form={f} />)}
            </div>
          </div>
        ))
      }
    </div>
  </section>
  <HelpBand />
</SiteLayout>

<style>
  .forms-index {
    display: grid;
    gap: 56px;
  }
  .forms-group {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 32px;
  }
  .forms-group h2 {
    font-size: 1.4rem;
  }
  @media (max-width: 860px) {
    .forms-group {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
