---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import CtaButtons from '../components/CtaButtons.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, experience } from '../data/site';
import { homeFaqs } from '../data/faqs';
import { libraryScreenshot } from '../data/media';

const howSteps = [
  {
    image: '/images/how-maintenance.webp',
    alt: 'Business owner reviewing plan documents on a laptop',
    title: 'Keep Your Maintenance Active',
    text: 'Renew your annual service so our team can continue providing covered document updates, maintenance, and administrative support.',
  },
  {
    image: '/images/how-learning.webp',
    alt: 'Plan owner reading through printed plan materials',
    title: 'Use Your Member Learning Library',
    text: 'Find practical explanations of common plan questions, routine paperwork, and annual responsibilities in one organized place.',
  },
  {
    image: '/images/how-changes.webp',
    alt: 'Two business partners reviewing details on a tablet',
    title: 'Tell Us When Something Changes',
    text: 'Changes to your business, trustees, or plan details may require additional paperwork. Our team helps identify the appropriate next step.',
  },
];
---

<SiteLayout
  overlayHeader
  title="Self-Directed 401(k) Maintenance & Support | The Tax Academy"
  description="Required document updates, ongoing administrative support, and practical education to help you understand and maintain your self-directed 401(k)."
>
  <!-- A. Main introduction -->
  <section class="hero on-dark">
    <img
      class="hero-bg"
      src="/images/hero-team.webp"
      srcset="/images/hero-team-900.webp 900w, /images/hero-team.webp 1536w"
      sizes="100vw"
      alt=""
      width="1536"
      height="1024"
      fetchpriority="high"
    />
    <div class="hero-inner">
      <div class="container hero-bottom">
        <h1 class="hero-title">
          <span class="hero-line" data-line="1">Keep Your Self-Directed</span>{' '}
          <span class="hero-line" data-line="2">401(k) Current.</span>
        </h1>
      </div>
      {/* Same container as the header, so the copy lines up with the nav */}
      <div class="container hero-top">
        <div class="hero-copy">
          <p class="hero-lead">
            Required document updates, ongoing administrative support, and practical education to help you{' '}
            <span class="hl">understand and maintain your plan.</span>
          </p>
          <p class="hero-experience">{experience}</p>
          <div class="hero-actions">
            <CtaButtons />
          </div>
          <ul class="benefit-line" aria-label="What you get">
            <li>Ongoing document maintenance</li>
            <li>Attorney-reviewed learning</li>
            <li>Experienced support</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- C. How it works (placed right after the hero) -->
  <section class="how on-dark" id="how-it-works">
    <div class="how-grid">
      <div class="how-intro">
        <div>
          <span class="eyebrow">How it works</span>
          <h2>Maintain Your Plan. Understand Your Responsibilities. Know Where to Turn.</h2>
          <p>
            Your annual service covers the maintenance described on the renewal page. Individually requested changes and
            additional services are identified separately.
          </p>
        </div>
        <a href="/member-benefits/" class="button">See Member Benefits<Icon name="arrowRight" size={17} /></a>
      </div>
      {
        howSteps.map((step) => (
          <article class="how-step">
            <img src={step.image} alt={step.alt} width="640" height="672" loading="lazy" />
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- B. Why ongoing maintenance matters -->
  <section class="section maintenance">
    <div class="container maintenance-grid">
      <div>
        <span class="eyebrow">Ongoing maintenance</span>
        <h2>The Rules Change. Your Plan Does Not Update Itself.</h2>
        <p class="lede">
          Retirement-plan requirements evolve. Documents prepared years ago may need amendments or restatements to meet
          later requirements.
        </p>
        <p class="lede">
          Our attorney and our team have helped plan owners navigate an industry that continues to change. We bring that
          experience to your ongoing document maintenance, helping you understand required updates and the steps needed to
          keep your plan documents current.
        </p>
      </div>
      <div class="maintenance-side">
        <blockquote class="statement on-dark">
          <Icon name="refreshCw" size={26} stroke={1.6} />
          <p>When the rules change, we help you stay ahead of required document updates.</p>
        </blockquote>
        <div class="renewal-connection">
          <p>Keeping your renewal current keeps our maintenance and update service active.</p>
          <a href="/renewal-page/" class="text-link">Renew My Plan<Icon name="arrowRight" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- D. Chatbot questions and the learning library -->
  <section class="section library">
    <div class:list={['container', 'library-grid', { 'has-shot': libraryScreenshot }]}>
      <div>
        <span class="eyebrow">Member learning library</span>
        <h2>Your Chatbot Gave You an Answer. Is It Right for Your Plan?</h2>
        <p class="lede">An answer is only useful when you understand what it means, how it applies, and what to do next.</p>
        <p class="lede">
          Our member learning library is built around the questions our team has encountered throughout nearly 30 years of
          retirement-plan work. Reviewed by our attorney, the material explains common processes, important limitations,
          and situations that need additional attention.
        </p>
        <p class="lede">
          Instead of piecing together disconnected answers, start with practical education organized around the plan you
          own.
        </p>
        {libraryScreenshot && <p class="statement-inline">Real questions. Practical explanations. Experience behind the education.</p>}
        <a href="/member-benefits/#learning-library" class="button button-dark">
          Explore the Member Learning Library<Icon name="arrowRight" size={17} />
        </a>
      </div>
      {
        libraryScreenshot ? (
          <figure class="shot">
            <img src={libraryScreenshot.src} alt={libraryScreenshot.alt} loading="lazy" />
            <figcaption>{libraryScreenshot.caption}</figcaption>
          </figure>
        ) : (
          <blockquote class="statement statement-lg on-dark">
            <Icon name="graduationCap" size={30} stroke={1.5} />
            <p>Real questions. Practical explanations. Experience behind the education.</p>
          </blockquote>
        )
      }
    </div>
  </section>

  <!-- E. Switching providers -->
  <section class="slant on-dark">
    <div class="container switch-grid">
      <div>
        <span class="eyebrow">Switch providers</span>
        <h2>Already Have a Plan Somewhere Else?</h2>
      </div>
      <div class="switch-copy">
        <p class="lede">Bring your existing plan’s document maintenance and support to The Tax Academy.</p>
        <p class="lede">
          Our team will review your current documents, explain whether we can support your plan, and outline the work and
          fees involved before you proceed.
        </p>
        <p class="lede">
          Once your transition is complete, you receive ongoing maintenance and access to our member learning library.
        </p>
        <a href="/switch-providers/#request-review" class="button">Start a Provider Review<Icon name="arrowRight" size={17} /></a>
        <p class="switch-note">
          <Icon name="info" size={16} />
          This review concerns your plan’s documents and support services, not the custody of your retirement funds.
        </p>
      </div>
    </div>
  </section>

  <!-- F. Homepage questions -->
  <Faq items={homeFaqs} title="Common Questions" />

  <!-- G. Advanced-help referral (kept visually secondary) -->
  <section class="container advanced" id="advanced-help">
    <div class="advanced-row">
      <div>
        <h2>Need Help Beyond Routine Plan Maintenance?</h2>
        <p>Explore advanced attorney-led education, specialized services, and events through IRA Ideas.</p>
      </div>
      <a href={site.iraIdeasUrl} class="text-link" target="_blank" rel="noopener">
        Explore IRA Ideas<Icon name="external" size={15} />
      </a>
    </div>
  </section>

  <!-- H. Final call to action -->
  <CtaBand
    title="Keep Your Plan Maintained. Keep Your Knowledge Current."
    text="Renew your annual maintenance or ask about bringing your existing plan to The Tax Academy."
  />
</SiteLayout>

<style>
  /* A. Hero — full-bleed photo, copy on the right, oversized two-line headline along the bottom */
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--ink);
    color: #fff;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  /* Light overall tint, deeper toward the bottom where the headline sits */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(0deg, rgba(0, 20, 24, 0.72) 0%, rgba(0, 20, 24, 0.2) 45%, transparent 70%),
      rgba(0, 20, 24, 0.42);
  }

  .hero {
    /* The headline gets a wider area than the site container so 160px fits on large screens */
    --hero-max: 1680px;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(32px, 5vw, 64px);
    min-height: min(100vh, 980px);
    padding-block: calc(var(--plate-h) - 40px) clamp(32px, 4vw, 56px);
  }

  /* Copy sits above the headline visually, but the headline comes first in the markup */
  .hero-top {
    order: -1;
    display: flex;
    justify-content: flex-end;
  }

  .hero-bottom {
    max-width: calc(var(--hero-max) + var(--gutter) * 2);
  }

  .hero-copy {
    width: 100%;
    max-width: 560px;
    margin-top: 100px;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
  }

  .hero-title {
    /* 160px where it fits; below that, scale so the first line fills the available width.
       -4.8px at 160px is -0.03em, so the spacing scales with the size. */
    font-family: 'Rethink Sans Variable', 'Rethink Sans', sans-serif;
    font-size: min(160px, (min(100vw, var(--hero-max) + var(--gutter) * 2) - var(--gutter) * 2) / var(--title-ratio));
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.25);
    /* Width of "Keep Your Self-Directed" divided by font size (measured), plus a little slack */
    --title-ratio: 10.2;
  }

  .hero-line {
    display: block;
    white-space: nowrap;
  }

  .hero-lead {
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    font-weight: 500;
    line-height: 1.5;
  }

  .hl {
    color: #b6e59a;
  }

  .hero-experience {
    margin-top: 14px;
    color: #e3ecec;
    font-size: 1rem;
  }

  .hero-actions {
    margin-top: 26px;
  }

  .benefit-line {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    color: #e3ecec;
    font-size: 0.9rem;
  }

  .benefit-line li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .benefit-line li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lime);
  }

  @media (max-width: 900px) {
    .hero-inner {
      justify-content: flex-end;
      gap: 28px;
      min-height: 0;
      padding-top: calc(var(--plate-h) + 48px);
    }

    .hero-top {
      order: 0;
      justify-content: flex-start;
    }

    .hero-copy {
      max-width: 640px;
      margin-top: 0;
    }

    .hero::before {
      background:
        linear-gradient(0deg, rgba(0, 20, 24, 0.9) 0%, rgba(0, 20, 24, 0.7) 60%, rgba(0, 20, 24, 0.5) 100%);
    }
  }

  /* Phones: let the headline wrap naturally */
  @media (max-width: 560px) {
    .hero-title {
      font-size: clamp(2.6rem, 11vw, 3.4rem);
    }

    .hero-line {
      display: inline;
      white-space: normal;
    }
  }

  /* B. Maintenance — the most prominent content section */
  .maintenance {
    background:
      radial-gradient(600px 300px at 100% 0%, rgba(116, 191, 68, 0.14), transparent 70%),
      var(--cream);
    border-bottom: 1px solid var(--line);
  }

  .maintenance-grid,
  .library-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }

  .maintenance h2 {
    font-size: clamp(2rem, 4vw, 3.1rem);
    margin-bottom: 20px;
  }

  .maintenance .lede + .lede,
  .library .lede + .lede,
  .switch-copy .lede + .lede {
    margin-top: 14px;
  }

  .maintenance-side {
    display: grid;
    gap: 20px;
  }

  .statement {
    margin: 0;
    padding: 32px;
    border-radius: var(--radius);
    background: var(--ink);
    color: #fff;
  }

  .statement :global(.icon) {
    color: var(--lime);
    margin-bottom: 16px;
  }

  .statement p {
    font-size: clamp(1.3rem, 2.2vw, 1.65rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .statement-lg {
    padding: clamp(32px, 4vw, 48px);
  }

  .statement-lg p {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  .renewal-connection {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    padding: 20px 24px;
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--line);
  }

  .renewal-connection p {
    max-width: 36ch;
    font-weight: 500;
  }

  /* C. How it works — full-width band, four columns split by hairlines */
  .how {
    background: var(--ink);
    color: #fff;
    scroll-margin-top: 0;
  }

  .how-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .how-grid > * {
    padding: clamp(56px, 6vw, 110px) clamp(20px, 2vw, 32px) clamp(56px, 6vw, 120px);
  }

  .how-grid > * + * {
    border-left: 1px solid var(--line-dark);
  }

  .how-intro {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
  }

  .how-intro h2 {
    margin-bottom: 20px;
    font-size: clamp(1.7rem, 2.3vw, 2.35rem);
    line-height: 1.15;
  }

  .how-intro p {
    max-width: 36ch;
    color: var(--muted-on-dark);
    font-size: 0.95rem;
  }

  .how-intro .button {
    align-self: flex-start;
  }

  .how-step img {
    width: 100%;
    height: auto;
    aspect-ratio: 416 / 436;
    object-fit: cover;
    margin-bottom: 28px;
  }

  .how-step h3 {
    margin-bottom: 14px;
    font-size: clamp(1.25rem, 1.5vw, 1.5rem);
    font-weight: 500;
  }

  .how-step p {
    color: var(--muted-on-dark);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  @media (max-width: 1100px) {
    .how-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .how-grid > :nth-child(3) {
      border-left: 0;
    }

    .how-grid > :nth-child(n + 3) {
      border-top: 1px solid var(--line-dark);
    }
  }

  @media (max-width: 640px) {
    .how-grid {
      grid-template-columns: 1fr;
    }

    .how-grid > * + * {
      border-left: 0;
      border-top: 1px solid var(--line-dark);
    }

    .how-grid > * {
      padding: 48px var(--gutter);
    }
  }

  /* D. Library */
  .library h2 {
    margin-bottom: 20px;
  }

  .library .button {
    margin-top: 28px;
  }

  .statement-inline {
    margin-top: 20px;
    padding-left: 16px;
    border-left: 3px solid var(--lime);
    font-weight: 600;
  }

  .shot {
    margin: 0;
  }

  .shot img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
  }

  .shot figcaption {
    margin-top: 12px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* E. Switching */
  .switch-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(24px, 6vw, 88px);
  }

  .switch-grid h2 {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .switch-copy .button {
    margin-top: 28px;
  }

  .switch-note {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    margin-top: 20px;
    color: var(--muted-on-dark);
    font-size: 0.875rem;
  }

  .switch-note :global(.icon) {
    flex: none;
    margin-top: 3px;
    color: var(--lime);
  }

  /* G. Advanced help — deliberately understated */
  .advanced {
    padding-bottom: clamp(48px, 6vw, 72px);
  }

  .advanced-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    padding: 24px 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .advanced h2 {
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }

  .advanced p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.925rem;
  }

  @media (max-width: 900px) {
    .maintenance-grid,
    .library-grid,
    .switch-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
