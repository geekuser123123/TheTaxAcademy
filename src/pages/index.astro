---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import CtaButtons from '../components/CtaButtons.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, experience } from '../data/site';
import { homeFaqs } from '../data/faqs';
import { libraryScreenshot } from '../data/media';
---

<SiteLayout
  overlayHeader
  title="Self-Directed 401(k) Maintenance & Support | The Tax Academy"
  description="Required document updates, ongoing administrative support, and practical education to help you understand and maintain your self-directed 401(k)."
>
  <!-- A. Main introduction -->
  <section class="hero on-dark">
    <img
      class="hero-bg"
      src="/images/hero-team.webp"
      srcset="/images/hero-team-900.webp 900w, /images/hero-team.webp 1536w"
      sizes="100vw"
      alt=""
      width="1536"
      height="1024"
      fetchpriority="high"
    />
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1><span class="h1-line">Keep Your Self-Directed</span> <span class="h1-line">401(k) Current.</span></h1>
        <p>
          Required document updates, ongoing administrative support, and practical education to help you understand and
          maintain your plan.
        </p>
        <p class="hero-experience">{experience}</p>
        <div class="hero-actions">
          <CtaButtons />
        </div>
        <ul class="benefit-line" aria-label="What you get">
          <li>Ongoing document maintenance</li>
          <li>Attorney-reviewed learning</li>
          <li>Experienced support</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- B. Why ongoing maintenance matters -->
  <section class="section maintenance">
    <div class="container maintenance-grid">
      <div>
        <span class="eyebrow">Ongoing maintenance</span>
        <h2>The Rules Change. Your Plan Does Not Update Itself.</h2>
        <p class="lede">
          Retirement-plan requirements evolve. Documents prepared years ago may need amendments or restatements to meet
          later requirements.
        </p>
        <p class="lede">
          Our attorney and our team have helped plan owners navigate an industry that continues to change. We bring that
          experience to your ongoing document maintenance, helping you understand required updates and the steps needed to
          keep your plan documents current.
        </p>
      </div>
      <div class="maintenance-side">
        <blockquote class="statement on-dark">
          <Icon name="refreshCw" size={26} stroke={1.6} />
          <p>When the rules change, we help you stay ahead of required document updates.</p>
        </blockquote>
        <div class="renewal-connection">
          <p>Keeping your renewal current keeps our maintenance and update service active.</p>
          <a href="/renewal-page/" class="text-link">Renew My Plan<Icon name="arrowRight" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- C. How it works -->
  <section class="section how on-dark" id="how-it-works">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">How it works</span>
          <h2>Maintain Your Plan. Understand Your Responsibilities. Know Where to Turn.</h2>
        </div>
      </div>
      <div class="grid-3">
        <div class="card how-card">
          <span class="how-num">01</span>
          <span class="icon-box"><Icon name="calendarCheck" size={22} stroke={1.6} /></span>
          <h3>Keep Your Maintenance Active</h3>
          <p>
            Renew your annual service so our team can continue providing covered document updates, maintenance, and
            administrative support.
          </p>
        </div>
        <div class="card how-card">
          <span class="how-num">02</span>
          <span class="icon-box"><Icon name="library" size={22} stroke={1.6} /></span>
          <h3>Use Your Member Learning Library</h3>
          <p>
            Find practical explanations of common plan questions, routine paperwork, and annual responsibilities in one
            organized place.
          </p>
        </div>
        <div class="card how-card">
          <span class="how-num">03</span>
          <span class="icon-box"><Icon name="filePen" size={22} stroke={1.6} /></span>
          <h3>Tell Us When Something Changes</h3>
          <p>
            Changes to your business, trustees, or plan details may require additional paperwork. Our team helps identify
            the appropriate next step.
          </p>
        </div>
      </div>
      <div class="how-foot">
        <p>
          Your annual service covers the maintenance described on the renewal page. Individually requested changes and
          additional services are identified separately.
        </p>
        <a href="/member-benefits/" class="button">See Member Benefits<Icon name="arrowRight" size={17} /></a>
      </div>
    </div>
  </section>

  <!-- D. Chatbot questions and the learning library -->
  <section class="section library">
    <div class:list={['container', 'library-grid', { 'has-shot': libraryScreenshot }]}>
      <div>
        <span class="eyebrow">Member learning library</span>
        <h2>Your Chatbot Gave You an Answer. Is It Right for Your Plan?</h2>
        <p class="lede">An answer is only useful when you understand what it means, how it applies, and what to do next.</p>
        <p class="lede">
          Our member learning library is built around the questions our team has encountered throughout nearly 30 years of
          retirement-plan work. Reviewed by our attorney, the material explains common processes, important limitations,
          and situations that need additional attention.
        </p>
        <p class="lede">
          Instead of piecing together disconnected answers, start with practical education organized around the plan you
          own.
        </p>
        {libraryScreenshot && <p class="statement-inline">Real questions. Practical explanations. Experience behind the education.</p>}
        <a href="/member-benefits/#learning-library" class="button button-dark">
          Explore the Member Learning Library<Icon name="arrowRight" size={17} />
        </a>
      </div>
      {
        libraryScreenshot ? (
          <figure class="shot">
            <img src={libraryScreenshot.src} alt={libraryScreenshot.alt} loading="lazy" />
            <figcaption>{libraryScreenshot.caption}</figcaption>
          </figure>
        ) : (
          <blockquote class="statement statement-lg on-dark">
            <Icon name="graduationCap" size={30} stroke={1.5} />
            <p>Real questions. Practical explanations. Experience behind the education.</p>
          </blockquote>
        )
      }
    </div>
  </section>

  <!-- E. Switching providers -->
  <section class="slant on-dark">
    <div class="container switch-grid">
      <div>
        <span class="eyebrow">Switch providers</span>
        <h2>Already Have a Plan Somewhere Else?</h2>
      </div>
      <div class="switch-copy">
        <p class="lede">Bring your existing plan’s document maintenance and support to The Tax Academy.</p>
        <p class="lede">
          Our team will review your current documents, explain whether we can support your plan, and outline the work and
          fees involved before you proceed.
        </p>
        <p class="lede">
          Once your transition is complete, you receive ongoing maintenance and access to our member learning library.
        </p>
        <a href="/switch-providers/#request-review" class="button">Start a Provider Review<Icon name="arrowRight" size={17} /></a>
        <p class="switch-note">
          <Icon name="info" size={16} />
          This review concerns your plan’s documents and support services, not the custody of your retirement funds.
        </p>
      </div>
    </div>
  </section>

  <!-- F. Homepage questions -->
  <Faq items={homeFaqs} title="Common Questions" />

  <!-- G. Advanced-help referral (kept visually secondary) -->
  <section class="container advanced" id="advanced-help">
    <div class="advanced-row">
      <div>
        <h2>Need Help Beyond Routine Plan Maintenance?</h2>
        <p>Explore advanced attorney-led education, specialized services, and events through IRA Ideas.</p>
      </div>
      <a href={site.iraIdeasUrl} class="text-link" target="_blank" rel="noopener">
        Explore IRA Ideas<Icon name="external" size={15} />
      </a>
    </div>
  </section>

  <!-- H. Final call to action -->
  <CtaBand
    title="Keep Your Plan Maintained. Keep Your Knowledge Current."
    text="Renew your annual maintenance or ask about bringing your existing plan to The Tax Academy."
  />
</SiteLayout>

<style>
  /* A. Hero — photo background; compact so the headline and both buttons show on load */
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--ink);
    color: #fff;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 30%;
  }

  /* Darken toward the left so the copy stays readable over the photo */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(0, 29, 33, 0.92) 0%, rgba(0, 29, 33, 0.78) 45%, rgba(0, 29, 33, 0.4) 76%, rgba(0, 29, 33, 0.15) 100%),
      linear-gradient(0deg, rgba(0, 29, 33, 0.55) 0%, transparent 40%);
  }

  .hero-grid {
    display: grid;
    min-height: min(92vh, 860px);
    align-content: center;
    padding-block: calc(var(--plate-h) + clamp(16px, 3vw, 40px)) clamp(56px, 7vw, 96px);
  }

  .hero h1 {
    font-size: clamp(2.6rem, 6.6vw, 6rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  /* Two lines on tablet and up; natural wrapping on phones */
  @media (min-width: 700px) {
    .h1-line {
      display: block;
      white-space: nowrap;
    }
  }

  .hero-copy > :not(h1) {
    max-width: 640px;
  }

  .hero-copy > p {
    max-width: 52ch;
    margin-top: 20px;
    color: #d3e0e0;
    font-size: 1.125rem;
  }

  .hero-copy > p.hero-experience {
    margin-top: 12px;
    color: #fff;
    font-weight: 500;
  }

  .hero-actions {
    margin-top: 28px;
  }

  .benefit-line {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    color: #d3e0e0;
    font-size: 0.9rem;
  }

  .benefit-line li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .benefit-line li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lime);
  }

  /* B. Maintenance — the most prominent content section */
  .maintenance {
    background:
      radial-gradient(600px 300px at 100% 0%, rgba(116, 191, 68, 0.14), transparent 70%),
      var(--cream);
    border-bottom: 1px solid var(--line);
  }

  .maintenance-grid,
  .library-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }

  .maintenance h2 {
    font-size: clamp(2rem, 4vw, 3.1rem);
    margin-bottom: 20px;
  }

  .maintenance .lede + .lede,
  .library .lede + .lede,
  .switch-copy .lede + .lede {
    margin-top: 14px;
  }

  .maintenance-side {
    display: grid;
    gap: 20px;
  }

  .statement {
    margin: 0;
    padding: 32px;
    border-radius: var(--radius);
    background: var(--ink);
    color: #fff;
  }

  .statement :global(.icon) {
    color: var(--lime);
    margin-bottom: 16px;
  }

  .statement p {
    font-size: clamp(1.3rem, 2.2vw, 1.65rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .statement-lg {
    padding: clamp(32px, 4vw, 48px);
  }

  .statement-lg p {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  .renewal-connection {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    padding: 20px 24px;
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--line);
  }

  .renewal-connection p {
    max-width: 36ch;
    font-weight: 500;
  }

  /* C. How it works */
  #how-it-works {
    scroll-margin-top: 24px;
  }

  .how {
    background:
      radial-gradient(700px 360px at 100% 0%, rgba(31, 154, 75, 0.22), transparent 65%),
      var(--ink);
    color: #fff;
  }

  #how-it-works h2 {
    max-width: 24ch;
  }

  .how-card {
    position: relative;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--line-dark);
  }

  .how-card p {
    color: var(--muted-on-dark);
  }

  .how-card .icon-box {
    margin-bottom: 20px;
  }

  .how-num {
    position: absolute;
    top: 24px;
    right: 28px;
    color: var(--muted-on-dark);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .how-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    margin-top: 32px;
  }

  .how-foot p {
    max-width: 62ch;
    color: var(--muted-on-dark);
    font-size: 0.95rem;
  }

  /* D. Library */
  .library h2 {
    margin-bottom: 20px;
  }

  .library .button {
    margin-top: 28px;
  }

  .statement-inline {
    margin-top: 20px;
    padding-left: 16px;
    border-left: 3px solid var(--lime);
    font-weight: 600;
  }

  .shot {
    margin: 0;
  }

  .shot img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
  }

  .shot figcaption {
    margin-top: 12px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* E. Switching */
  .switch-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(24px, 6vw, 88px);
  }

  .switch-grid h2 {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .switch-copy .button {
    margin-top: 28px;
  }

  .switch-note {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    margin-top: 20px;
    color: var(--muted-on-dark);
    font-size: 0.875rem;
  }

  .switch-note :global(.icon) {
    flex: none;
    margin-top: 3px;
    color: var(--lime);
  }

  /* G. Advanced help — deliberately understated */
  .advanced {
    padding-bottom: clamp(48px, 6vw, 72px);
  }

  .advanced-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    padding: 24px 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .advanced h2 {
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }

  .advanced p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.925rem;
  }

  @media (max-width: 900px) {
    .maintenance-grid,
    .library-grid,
    .switch-grid {
      grid-template-columns: 1fr;
    }

    /* On narrow screens the text spans the photo: darken it evenly */
    .hero::before {
      background: linear-gradient(0deg, rgba(0, 29, 33, 0.92) 0%, rgba(0, 29, 33, 0.78) 55%, rgba(0, 29, 33, 0.6) 100%);
    }
  }
</style>
