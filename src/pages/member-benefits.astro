---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaButtons from '../components/CtaButtons.astro';
import CtaBand from '../components/CtaBand.astro';
import { memberExperienceScreenshots } from '../data/media';
import type { IconName } from '../components/icons';

// TODO(confirm): the team must approve the final inclusion list so covered regulatory
// updates and separately billed custom work are clearly distinguished.
const includes: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'refreshCw',
    title: 'Required Document Updates',
    text: 'Ongoing support for applicable document amendments and updates covered by your maintenance service, including instructions for any required signatures or information.',
  },
  {
    icon: 'clipboardCheck',
    title: 'Administrative Support',
    text: 'Help understanding routine plan paperwork and identifying the next steps when plan details or business circumstances change.',
  },
  {
    icon: 'library',
    title: 'Member Learning Access',
    text: 'Organized, attorney-reviewed educational resources that explain common questions, practical processes, and annual responsibilities.',
  },
];

// TODO(confirm): show only categories that have matching material in the library.
const topics: { icon: IconName; title: string; text: string }[] = [
  { icon: 'bookOpen', title: 'Understanding Your Plan', text: 'Learn the basic structure, terminology, and responsibilities.' },
  {
    icon: 'arrowLeftRight',
    title: 'Contributions and Rollovers',
    text: 'Understand the fundamentals, common processes, and information needed before proceeding.',
  },
  { icon: 'wallet', title: 'Distributions', text: 'Learn about routine documentation and questions to consider before taking money out.' },
  { icon: 'calendarCheck', title: 'Annual Responsibilities', text: 'Understand ongoing maintenance and reporting considerations.' },
  { icon: 'filePen', title: 'Forms and Plan Changes', text: 'Learn how common changes connect to paperwork and support requests.' },
  { icon: 'circleHelp', title: 'Common Questions and Mistakes', text: 'Find practical explanations drawn from recurring plan-owner questions.' },
];
---

<SiteLayout
  title="Plan Maintenance & Member Learning | The Tax Academy"
  description="Your Tax Academy membership combines ongoing document support with practical, attorney-reviewed education for your self-directed 401(k)."
>
  <!-- A. Introduction -->
  <PageHero
    eyebrow="Member benefits"
    title="The Maintenance Your Plan Needs. The Understanding You Need."
    lede="Your Tax Academy membership combines ongoing document support with practical, attorney-reviewed education."
  >
    <p class="lede" style="margin-top:14px">
      Keep your maintenance active, understand the fundamentals, and have an experienced team to turn to when plan questions
      arise.
    </p>
    <div style="margin-top:32px"><CtaButtons /></div>
  </PageHero>

  <!-- B. What membership includes -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">What membership includes</span>
          <h2>Support That Continues After the Original Paperwork.</h2>
        </div>
      </div>
      <div class="grid-3">
        {
          includes.map((item) => (
            <div class="card include-card">
              <span class="icon-box">
                <Icon name={item.icon} size={22} stroke={1.6} />
              </span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
      <p class="scope-line">
        <Icon name="info" size={17} />
        Additional services, including certain requested amendments, filing assistance, sponsor changes, and termination
        work, are priced separately.
      </p>
    </div>
  </section>

  <!-- C. Learning library -->
  <section class="section library" id="learning-library">
    <div class="container">
      <div class="library-intro">
        <div>
          <span class="eyebrow">Member learning library</span>
          <h2>Nearly 30 Years of Questions. Practical Answers in One Place.</h2>
        </div>
        <div>
          <p class="lede">
            Over the years, our attorney and our team have helped plan owners work through questions about documents,
            contributions, rollovers, distributions, and ongoing responsibilities.
          </p>
          <p class="lede">
            That experience shapes our member learning library. The goal is not to overwhelm you with technical material. It
            is to make useful information easier to find, understand, and put into context.
          </p>
        </div>
      </div>
      <div class="grid-3 topics">
        {
          topics.map((t) => (
            <div class="topic">
              <Icon name={t.icon} size={22} stroke={1.6} />
              <div>
                <h3>{t.title}</h3>
                <p>{t.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- D. Attorney review and practical experience -->
  <section class="section">
    <div class="container review">
      <div class="review-card on-dark">
        <span class="eyebrow">Attorney-reviewed education</span>
        <h2>More Than an Answer. An Explanation You Can Understand.</h2>
        <div class="review-copy">
          <p>
            Our educational materials are reviewed by our attorney and informed by our team’s experience helping real plan
            owners.
          </p>
          <p>Lessons explain the process, important limitations, and the circumstances that call for additional help.</p>
          <p>
            You get more than another answer to second-guess. You get an organized starting point for understanding your
            plan and the steps involved.
          </p>
        </div>
      </div>
      <p class="edu-note">
        Educational materials explain general processes. Your plan documents and individual circumstances determine what
        applies to a particular situation.
      </p>
    </div>
  </section>

  <!-- E. The actual member experience (shown only once approved screenshots exist) -->
  {
    memberExperienceScreenshots.length > 0 && (
      <section class="section" style="padding-top:0">
        <div class="container">
          <div class="section-heading">
            <div>
              <span class="eyebrow">Inside the member area</span>
              <h2>A Look at the Member Experience.</h2>
            </div>
          </div>
          <div class="grid-3">
            {memberExperienceScreenshots.map((s) => (
              <figure class="shot">
                <img src={s.src} alt={s.alt} loading="lazy" />
                <figcaption>{s.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand title="Ongoing Maintenance. Practical Learning. One Established Team." />
</SiteLayout>

<style>
  .include-card .icon-box {
    margin-bottom: 20px;
    background: #fff;
  }

  .scope-line {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin-top: 24px;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .scope-line :global(.icon) {
    flex: none;
    margin-top: 3px;
    color: var(--green);
  }

  .library {
    background: var(--cream);
    scroll-margin-top: 16px;
  }

  .library-intro {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(24px, 5vw, 72px);
    align-items: end;
    margin-bottom: 44px;
  }

  .library-intro .lede + .lede {
    margin-top: 14px;
  }

  .topic {
    display: flex;
    gap: 16px;
    padding: 24px;
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--line);
  }

  .topic > :global(.icon) {
    flex: none;
    color: var(--green);
    margin-top: 2px;
  }

  .topic h3 {
    margin-bottom: 6px;
  }

  .topic p {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .review-card {
    padding: clamp(32px, 5vw, 56px);
    border-radius: 20px;
    background:
      radial-gradient(600px 300px at 100% 0%, rgba(31, 154, 75, 0.3), transparent 65%),
      var(--ink);
    color: #fff;
  }

  .review-card h2 {
    max-width: 22ch;
    margin-bottom: 24px;
  }

  .review-copy {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    color: var(--muted-on-dark);
  }

  .edu-note {
    margin-top: 16px;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .shot {
    margin: 0;
  }

  .shot img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .shot figcaption {
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 860px) {
    .library-intro,
    .review-copy {
      grid-template-columns: 1fr;
    }
  }
</style>
