---
// Landing page for invite and password-reset links created by the team.
import PortalLayout from '../../layouts/PortalLayout.astro';
import Icon from '../../components/Icon.astro';
import {
  destroyAllSessions,
  findAuthLink,
  hashPassword,
  markAuthLinkUsed,
  passwordProblem,
} from '../../lib/auth';
import { db } from '../../lib/db';

export const prerender = false;

const token = Astro.url.searchParams.get('token') ?? '';
const link = token ? await findAuthLink(token) : null;

let error = '';
if (link && Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const password = String(data.get('password') ?? '');
  const problem = passwordProblem(password);
  if (problem) error = problem;
  else if (password !== String(data.get('confirm') ?? '')) error = 'Passwords don’t match.';
  else {
    await db().prepare('UPDATE users SET password_hash = ? WHERE id = ?').bind(await hashPassword(password), link.user_id).run();
    await markAuthLinkUsed(link.id);
    await destroyAllSessions(link.user_id);
    return Astro.redirect('/portal/login?notice=password-set', 303);
  }
}
---

<PortalLayout title="Set your password" bare>
  <div class="auth-card">
    {
      link ? (
        <>
          <h2>{link.purpose === 'invite' ? `Welcome, ${link.name.split(' ')[0]}` : 'Choose a new password'}</h2>
          <p>
            {link.purpose === 'invite'
              ? 'Create a password to open your private client portal.'
              : 'Set a new password for your portal account.'}{' '}
            You’ll sign in as <strong>{link.email}</strong>.
          </p>
          {error && (
            <div class="alert alert-error" role="alert" style="margin-bottom:18px">
              <Icon name="circleAlert" size={18} />
              {error}
            </div>
          )}
          <form method="post">
            <input type="email" name="username" value={link.email} autocomplete="username" hidden readonly />
            <div class="field">
              <label for="password">New password</label>
              <input id="password" name="password" type="password" autocomplete="new-password" minlength="10" required />
              <span class="hint">At least 10 characters. A short phrase is easy to remember.</span>
            </div>
            <div class="field">
              <label for="confirm">Confirm password</label>
              <input id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="10" required />
            </div>
            <button class="button" type="submit">Save password</button>
          </form>
        </>
      ) : (
        <>
          <h2>This link has expired</h2>
          <p>
            Invitation and reset links work once and expire after a while. Ask the team for a fresh link and we’ll send
            it right over.
          </p>
          <a href="/forms/contact-team" class="button">Ask for a new link</a>
        </>
      )
    }
  </div>
</PortalLayout>
