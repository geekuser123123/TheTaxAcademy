---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import HelpBand from '../components/HelpBand.astro';
---

<SiteLayout title="Service coverage" description="What ongoing plan support typically includes, and what is scoped separately.">
  <PageHero
    eyebrow="Service coverage"
    title="What’s included, and what’s scoped separately."
    lede="Your service agreement controls exactly what’s covered. Here’s the general picture, so you know what to expect."
  />
  <section class="section">
    <div class="container grid-2">
      <div class="card">
        <h2 class="cov-title"><Icon name="check" size={22} />Typically included in ongoing support</h2>
        <ul class="cov">
          <li>Access to your current plan documents</li>
          <li>Required amendments and restatements for regulatory changes</li>
          <li>Answers to routine plan administration questions</li>
          <li>Guidance on which forms and documents you need</li>
          <li>A private client portal for documents and messages</li>
        </ul>
      </div>
      <div class="card" style="background:var(--ink); color:#fff">
        <h2 class="cov-title"><Icon name="clipboardCheck" size={22} />Scoped as a separate project</h2>
        <ul class="cov" style="color:var(--muted-on-dark)">
          <li>Legal, tax, or investment advice from outside professionals</li>
          <li>Trusts, estate, and asset protection work</li>
          <li>Complex transactions, entities, and real estate structuring</li>
          <li>Catching up on late filings or past-due records</li>
          <li>Plan terminations and major redesigns</li>
        </ul>
      </div>
    </div>
    <div class="container">
      <p style="margin-top:24px; color:var(--muted); max-width:70ch">
        Not sure where your request falls? Send it anyway. We’ll tell you whether it’s covered and agree on scope and fees
        before any separate work begins.
      </p>
    </div>
  </section>
  <HelpBand />
</SiteLayout>

<style>
  .card {
    padding: 36px;
  }
  .cov-title {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 1.3rem;
    margin-bottom: 16px;
  }
  .cov-title :global(.icon) {
    color: var(--lime);
    flex: none;
  }
  .cov {
    display: grid;
    gap: 10px;
    margin: 0;
    padding-left: 20px;
  }
</style>
