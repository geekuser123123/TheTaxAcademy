  .rn-price-term {
    margin-bottom: 8px;
    color: var(--rn-muted);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .rn-price-amount {
    margin-bottom: 8px;
    font-family: var(--font-heading);
    font-size: 48px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .rn-price-save {
    min-height: 1.4em;
    margin-bottom: 6px;
    color: var(--rn-green-hover);
    font-size: 13px;
    font-weight: 600;
    white-space: pre;
  }

  .rn-price-hint {
    color: var(--rn-muted);
    font-size: 12px;
    font-style: italic;
    font-weight: 300;
  }

  .is-featured .rn-price-term {
    color: rgba(246, 249, 241, 0.6);
  }

  .is-featured .rn-price-amount {
    color: var(--rn-pale);
  }

  .is-featured .rn-price-save {
    color: var(--rn-green);
  }

  .is-featured .rn-price-hint {
    color: rgba(246, 249, 241, 0.45);
  }

  /* ---- Add-ons ---- */
  .rn-addons-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 48px;
  }

  .rn-addon-wrap {
    position: relative;
    display: flex;
  }

  .rn-addon {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: 28px 24px;
    border: 2px solid var(--rn-border);
    border-radius: var(--rn-r);
    background: var(--rn-pale);
    color: var(--rn-dark);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
  }

  .rn-addon:not(:disabled):hover {
    border-color: var(--rn-green);
  }

  .rn-addon.is-selected {
    border-color: var(--rn-green);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(122, 188, 50, 0.1);
  }

  .rn-addon .rn-check {
    margin-bottom: 16px;
  }

  .rn-addon-name {
    margin-bottom: 6px;
    padding-right: 24px;
    font-size: 15px;
    font-weight: 600;
  }

  .rn-addon-price {
    margin-bottom: 8px;
    font-family: var(--rn-mono);
    font-size: 22px;
    font-weight: 500;
  }

  .rn-addon-desc {
    color: var(--rn-muted);
    font-size: 13px;
    font-weight: 300;
    line-height: 1.5;
  }

  .rn-tip {
    position: absolute;
    top: 24px;
    right: 20px;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--rn-muted);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    cursor: help;
  }

  .rn-tip-text {
    position: absolute;
    right: -8px;
    bottom: 28px;
    z-index: 10;
    display: none;
    width: 260px;
    padding: 10px 12px;
    border-radius: 8px;
    background: var(--rn-dark);
    color: var(--rn-pale);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.5;
    text-align: left;
    box-shadow: 0 8px 24px rgba(0, 29, 33, 0.2);
  }

  .rn-tip:hover .rn-tip-text,
  .rn-tip:focus .rn-tip-text {
    display: block;
  }

  .rn-hint {
    margin-top: 20px;
    padding: 12px 16px;
    border-left: 3px solid var(--rn-green);
    border-radius: 0 8px 8px 0;
    background: rgba(122, 188, 50, 0.08);
    color: var(--rn-dark);
    font-size: 14px;
  }

  .rn-hint a {
    color: var(--rn-green-hover);
    font-weight: 600;
  }

  /* ---- Why it matters ---- */
  .rn-why {
    padding: 72px 0;
    background: var(--rn-dark);
  }

  .rn-why-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }

  .rn-why-title {
    margin-bottom: 12px;
    color: var(--rn-pale);
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .rn-why-sub {
    color: rgba(246, 249, 241, 0.55);
    font-size: 15px;
    font-weight: 300;
  }

  .rn-why-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rn-why-list li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 20px;
    border: 1px solid rgba(246, 249, 241, 0.08);
    border-radius: 10px;
    background: rgba(246, 249, 241, 0.04);
  }

  .rn-why-list p {
    margin: 0;
    color: rgba(246, 249, 241, 0.75);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.55;
  }

  .rn-why-list .rn-why-statement {
    border-color: rgba(122, 188, 50, 0.3);
    background: rgba(122, 188, 50, 0.08);
  }

  .rn-why-statement p {
    color: var(--rn-pale);
    font-weight: 500;
  }

  .rn-why-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(246, 249, 241, 0.1);
    color: var(--rn-pale);
  }

  .rn-why-icon.is-green {
    background: var(--rn-green);
    color: var(--rn-dark);
  }

  /* ---- Closing ---- */
  .rn-cancel-card {
    display: block;
    width: 100%;
    margin-top: 48px;
    padding: 36px 40px;
    border: 2px solid var(--rn-border);
    border-radius: var(--rn-r-lg);
    background: #fff;
    color: var(--rn-dark);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .rn-cancel-card:hover {
    border-color: var(--rn-red);
  }

  .rn-cancel-card.is-selected {
    border-color: var(--rn-red);
    box-shadow: 0 0 0 4px rgba(226, 75, 75, 0.08);
  }

  .rn-cancel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }

  .rn-cancel-left {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .rn-cancel-left .rn-check {
    width: 22px;
    height: 22px;
    margin-top: 2px;
  }

  .rn-cancel-title {
    display: block;
    margin-bottom: 6px;
    font-size: 17px;
    font-weight: 600;
  }

  .rn-cancel-sub {
    display: block;
    max-width: 640px;
    color: var(--rn-muted);
    font-size: 14px;
    font-weight: 300;
  }

  .rn-cancel-price {
    font-family: var(--rn-mono);
    font-size: 28px;
    font-weight: 500;
    white-space: nowrap;
  }

  .rn-cancel-note {
    display: flex;
    gap: 10px;
    margin: 16px 0 0;
    padding: 12px 16px;
    border: 1px solid var(--rn-border);
    border-radius: 8px;
    background: #fff;
    color: var(--rn-muted);
    font-size: 13px;
  }

  .rn-cancel-note :global(.icon) {
    flex: none;
    margin-top: 2px;
    color: var(--rn-green-hover);
  }

  /* ---- FAQ ---- */
  .rn-faq {
    display: grid;
    gap: 8px;
    margin-top: 40px;
  }

  .rn-faq details {
    overflow: hidden;
    border: 1px solid var(--rn-border);
    border-radius: var(--rn-r);
    background: #fff;
  }

  .rn-faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 28px;
    font-size: 16px;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
    transition: background 0.15s;
  }

  .rn-faq summary::-webkit-details-marker {
    display: none;
  }

  .rn-faq summary:hover {
    background: var(--rn-pale);
  }

  .rn-faq-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--rn-pale);
    color: var(--rn-green-hover);
    font-size: 18px;
    font-weight: 400;
    line-height: 1;
    transition: transform 0.2s, background 0.15s;
  }

  .rn-faq details[open] .rn-faq-icon {
    background: var(--rn-green);
    color: var(--rn-dark);
    transform: rotate(45deg);
  }

  .rn-faq-answer {
    padding: 16px 28px 22px;
    border-top: 1px solid var(--rn-pale);
    color: var(--rn-muted);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.7;
  }

  .rn-faq-answer p + p {
    margin-top: 10px;
  }

  /* ---- Final CTA ---- */
  .rn-final {
    position: relative;
    overflow: hidden;
    padding: clamp(64px, 9vw, 96px) 0;
    background: var(--rn-dark);
    text-align: center;
  }

  .rn-final::before {
    content: '';
    position: absolute;
    top: -100px;
    left: 50%;
    width: min(800px, 100%);
    height: 400px;
    background: radial-gradient(ellipse, rgba(122, 188, 50, 0.1) 0%, transparent 70%);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .rn-final .container {
    position: relative;
  }

  .rn-final h2 {
    margin-bottom: 16px;
    color: var(--rn-pale);
    font-size: clamp(30px, 4vw, 52px);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .rn-final p {
    max-width: 620px;
    margin: 0 auto 40px;
    color: rgba(246, 249, 241, 0.55);
    font-size: 16px;
    font-weight: 300;
  }

  .rn-final .rn-final-sub {
    margin: 16px auto 0;
    color: rgba(246, 249, 241, 0.35);
    font-size: 13px;
  }

  /* ---- Sticky bar ---- */
  .rn-sticky {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
    border-top: 1px solid var(--rn-border);
    background: #fff;
    box-shadow: 0 -4px 24px rgba(0, 29, 33, 0.08);
    transform: translateY(100%);
    transition: transform 0.3s;
  }

  .rn-sticky.is-visible {
    transform: translateY(0);
  }

  :global(body.rn-has-sticky) {
    padding-bottom: 80px;
  }

  :global(body.rn-locked) {
    overflow: hidden;
  }

  .rn-sticky-label {
    color: var(--rn-muted);
    font-size: 12px;
  }

  .rn-sticky-total {
    font-family: var(--font-heading);
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .rn-sticky-total small {
    margin-left: 6px;
    color: var(--rn-muted);
    font-family: var(--font);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
  }

  .rn-sticky-right {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .rn-sticky-selection {
    color: var(--rn-muted);
    font-size: 13px;
  }

  /* ---- Checkout modal ---- */
  .rn-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(0, 29, 33, 0.75);
    opacity: 0;
    transition: opacity 0.25s;
  }

  .rn-modal-overlay.is-open {
    opacity: 1;
  }

  .rn-modal {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 1060px;
    max-height: 92vh;
    overflow: hidden;
    border-radius: 20px;
    background: #fff;
    transform: translateY(24px);
    transition: transform 0.25s;
  }

  .rn-modal-overlay.is-open .rn-modal {
    transform: none;
  }

  .rn-modal-header {
    display: flex;
    flex: none;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 40px 24px;
    background: var(--rn-dark);
  }

  .rn-modal-title {
    color: var(--rn-pale);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .rn-modal-sub {
    margin-top: 4px;
    color: rgba(246, 249, 241, 0.55);
    font-size: 14px;
    font-weight: 300;
  }

  .rn-modal-close {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: rgba(246, 249, 241, 0.1);
    color: rgba(246, 249, 241, 0.7);
    cursor: pointer;
  }

  .rn-modal-close:hover {
    background: rgba(246, 249, 241, 0.2);
    color: var(--rn-pale);
  }

  .rn-modal-body {
    display: grid;
    flex: 1;
    grid-template-columns: 1fr 340px;
    min-height: 0;
  }

  .rn-modal-left {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 32px 40px;
    overflow-y: auto;
  }

  .rn-modal-right {
    display: flex;
    flex-direction: column;
    padding: 32px 28px;
    overflow-y: auto;
    border-left: 1px solid var(--rn-border);
    background: var(--rn-pale);
  }

  .rn-msec {
    padding-bottom: 24px;
    border-bottom: 1px solid var(--rn-border);
  }

  .rn-msec-label,
  .rn-mform-label {
    display: block;
    margin-bottom: 12px;
    color: var(--rn-muted);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .rn-mform-label {
    margin-bottom: 6px;
    font-size: 12px;
    letter-spacing: 0.07em;
  }

  .rn-mlist {
    display: grid;
    gap: 10px;
  }

  .rn-mopt {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 14px 18px;
    border: 2px solid var(--rn-border);
    border-radius: 10px;
    background: var(--rn-pale);
    color: var(--rn-dark);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }

  .rn-mopt .rn-radio,
  .rn-mopt .rn-check {
    width: 18px;
    height: 18px;
  }

  .rn-mopt .rn-radio::after {
    width: 9px !important;
    height: 9px !important;
  }

  .rn-mopt .rn-check::after {
    top: 1px !important;
    left: 4px !important;
    height: 8px !important;
  }

  .rn-mopt:not(:disabled):hover {
    border-color: var(--rn-green);
  }

  .rn-mopt.is-selected {
    border-color: var(--rn-green);
    background: #fff;
  }

  .rn-mopt-red:hover,
  .rn-mopt-red.is-selected {
    border-color: var(--rn-red) !important;
  }

  .rn-mopt-red.is-selected {
    background: #fff8f8;
  }

  .rn-mopt-info {
    flex: 1;
    min-width: 0;
  }

  .rn-mopt-name {
    display: block;
    font-size: 15px;
    font-weight: 500;
  }

  .rn-mopt-save {
    display: block;
    color: var(--rn-green-hover);
    font-size: 12px;
    font-weight: 500;
  }

  .rn-mopt-desc {
    display: block;
    margin-top: 2px;
    color: var(--rn-muted);
    font-size: 12px;
  }

  .rn-mopt-price {
    font-family: var(--rn-mono);
    font-size: 17px;
    font-weight: 500;
    white-space: nowrap;
  }

  .rn-mnote {
    margin: 10px 0 0;
    padding: 10px 12px;
    border: 1px solid var(--rn-border);
    border-radius: 8px;
    background: var(--rn-pale);
    color: var(--rn-muted);
    font-size: 13px;
  }

  .rn-verify-row {
    display: flex;
    gap: 8px;
  }

  .rn-input {
    flex: 1;
    min-width: 0;
    padding: 11px 14px;
    border: 1.5px solid var(--rn-border);
    border-radius: 8px;
    background: #fff;
    color: var(--rn-dark);
    font: inherit;
    font-size: 15px;
    outline: none;
    transition: border-color 0.15s;
  }

  .rn-input:focus {
    border-color: var(--rn-green);
  }

  .rn-verify-status {
    min-height: 1em;
    margin: 6px 0 0;
    color: var(--rn-muted);
    font-size: 13px;
  }

  .rn-verify-status.is-ok {
    color: var(--rn-green-hover);
  }

  .rn-verify-status.is-error {
    color: #a32d2d;
  }

  .rn-account {
    display: flex;
    gap: 10px;
    margin-top: 10px;
    padding: 12px 14px;
    border: 1px solid rgba(122, 188, 50, 0.3);
    border-radius: 8px;
    background: rgba(122, 188, 50, 0.08);
    font-size: 14px;
  }

  .rn-account .rn-trust-check {
    margin-top: 3px;
  }

  .rn-account strong,
  .rn-account span:not(.rn-trust-check) {
    display: block;
  }

  .rn-account span:not(.rn-trust-check) {
    color: var(--rn-muted);
    font-size: 13px;
  }

  .rn-card-icons {
    display: flex;
    gap: 6px;
    margin-bottom: 14px;
  }

  .rn-card-icons span {
    padding: 3px 8px;
    border: 1px solid var(--rn-border);
    border-radius: 5px;
    background: var(--rn-pale);
    color: var(--rn-muted);
    font-size: 11px;
    font-weight: 600;
  }

  .rn-card-container {
    min-height: 90px;
    padding: 12px;
    border: 1.5px solid var(--rn-border);
    border-radius: 8px;
    background: #fff;
  }

  .rn-error {
    margin: 8px 0 0;
    padding: 10px 14px;
    border: 1px solid rgba(226, 75, 75, 0.3);
    border-radius: 8px;
    background: rgba(226, 75, 75, 0.08);
    color: #a32d2d;
    font-size: 13px;
  }

  [data-pay-error] {
    margin: 0 0 12px;
  }

  .rn-submit {
    width: 100%;
    padding: 16px;
    border: 0;
    border-radius: 10px;
    background: var(--rn-green);
    color: var(--rn-dark);
    font: inherit;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    cursor: pointer;
    transition: background 0.18s, transform 0.12s;
  }

  .rn-submit:hover {
    background: var(--rn-green-hover);
    transform: translateY(-1px);
  }

  .rn-submit:disabled {
    opacity: 0.6;
    cursor: wait;
    transform: none;
  }

  .rn-submit-sub {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 10px;
    color: var(--rn-muted);
    font-size: 12px;
    text-align: center;
  }

  .rn-submit-sub :global(.icon) {
    flex: none;
    color: var(--rn-green-hover);
  }

  .rn-order-title {
    margin-bottom: 12px;
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .rn-modal-right :global(.rn-order-line) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--rn-border);
    font-size: 14px;
  }

  .rn-modal-right :global(.rn-order-line span:last-child) {
    font-family: var(--rn-mono);
    white-space: nowrap;
  }

  .rn-fee-note {
    margin: 10px 0 0;
    color: var(--rn-muted);
    font-size: 12px;
    font-style: italic;
  }

  .rn-order-total {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 12px;
    padding-top: 16px;
    border-top: 2px solid var(--rn-dark);
    font-size: 15px;
    font-weight: 600;
  }

  .rn-order-total strong {
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .rn-order-box {
    margin-top: 20px;
    padding: 16px;
    border: 1px solid var(--rn-border);
    border-radius: 10px;
    background: #fff;
    font-size: 13px;
  }

  .rn-order-box-green {
    border-color: rgba(122, 188, 50, 0.25);
    background: rgba(122, 188, 50, 0.08);
  }

  .rn-order-box small {
    display: block;
    margin-top: 3px;
    color: var(--rn-muted);
    font-size: 12px;
  }

  .rn-order-box-label {
    margin-bottom: 8px;
    color: var(--rn-muted);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .rn-order-box-green .rn-order-box-label {
    color: var(--rn-green-hover);
  }

  .rn-next {
    display: grid;
    gap: 8px;
    margin: 0;
    padding-left: 18px;
    font-size: 12px;
  }

  .rn-next :global(li::marker) {
    color: var(--rn-green-hover);
    font-weight: 700;
  }

  /* ---- Confirmation ---- */
  .rn-confirm {
    position: fixed;
