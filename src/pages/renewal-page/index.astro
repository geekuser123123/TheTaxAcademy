---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import type { IconName } from '../../components/icons';
import { renewalFaqs } from '../../data/faqs';
import { money, renewalServices, renewalTerms, square, terminationFee } from '../../data/renewal';
import { site } from '../../data/site';

const defaultTerm = renewalTerms[0];

const benefits: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'fileCheck',
    title: 'Plan Document Maintenance',
    text: 'Continued maintenance of your plan documentation within the annual service scope.',
  },
  {
    icon: 'refreshCw',
    title: 'Required Document Updates',
    text: 'Applicable updates covered by your service, with instructions for information or signatures needed from you.',
  },
  {
    icon: 'clipboardCheck',
    title: 'Administrative Support',
    text: 'Assistance with routine documentation questions and identifying appropriate next steps.',
  },
  {
    icon: 'library',
    title: 'Member Learning Access',
    text: 'Continued access to practical, attorney-reviewed educational resources.',
  },
];
---

<SiteLayout
  title="Renew Your Plan Maintenance | The Tax Academy"
  description="Annual renewal keeps your Tax Academy document maintenance, required-update service, administrative support, and member learning access active."
>
  <!-- A. Introduction -->
  <PageHero
    eyebrow="Renew my plan"
    title="Renew Your Plan Maintenance. Keep Required Updates on Track."
    lede="Annual renewal is required to continue your Tax Academy document maintenance, required-update service, administrative support, and member learning access."
  >
    <p class="lede" style="margin-top:14px">Keep the support behind your plan active as retirement-plan requirements evolve.</p>
    <a href="#renewal-options" class="button" style="margin-top:32px">
      Choose My Renewal Term<Icon name="arrowDown" size={17} />
    </a>
    <p class="hero-small">Backed by our attorney and our team’s nearly 30 years of retirement-plan experience.</p>
  </PageHero>

  <!-- B. Why maintenance matters -->
  <section class="section">
    <div class="container">
      <div class="info-panel">
        <span class="icon-box"><Icon name="info" size={24} stroke={1.6} /></span>
        <div>
          <h2>Your Plan’s Requirements Continue After Setup.</h2>
          <div class="info-copy">
            <p>
              A retirement plan is not finished when the original documents are signed. Applicable amendments and
              restatements must be completed as requirements change.
            </p>
            <p>
              Missing required document updates can jeopardize the plan’s tax-qualified status and require corrective work.
              Losing tax-favored treatment can also affect contribution deductions and rollover eligibility.
            </p>
            <p>Keeping your Tax Academy renewal current keeps our maintenance and update service in place.</p>
          </div>
          <p class="info-statement">Keep your maintenance current instead of waiting for a document problem to surface.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- C. What renewal includes -->
  <section class="section includes">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">What’s included</span>
          <h2>What Your Renewal Keeps Active.</h2>
        </div>
      </div>
      <div class="benefit-grid">
        {
          benefits.map((b) => (
            <div class="card card-white">
              <span class="icon-box">
                <Icon name={b.icon} size={22} stroke={1.6} />
              </span>
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </div>
          ))
        }
      </div>
      <p class="muted-line">Individual plan changes, filing assistance, and other additional work are listed separately below.</p>
    </div>
  </section>

  <form id="renewal-form" data-renewal novalidate>
    <!-- D. Renewal options -->
    <section class="section" id="renewal-options">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Renewal options</span>
            <h2>Select Your Maintenance Term.</h2>
          </div>
          <p>
            Keep your annual maintenance active for one, two, or three years. Multi-year options prepay the selected
            maintenance period.
          </p>
        </div>
        <fieldset class="terms">
          <legend class="sr-only">Maintenance term</legend>
          {
            renewalTerms.map((t) => (
              <label class="term">
                <input
                  type="radio"
                  name="term"
                  value={t.id}
                  checked={t.id === defaultTerm.id}
                  required
                  data-label={t.label}
                  data-price={t.price}
                />
                {t.badge && <span class="term-badge">{t.badge}</span>}
                <span class="term-years">
                  {t.years} {t.years === 1 ? 'year' : 'years'}
                </span>
                <span class="term-price">{money(t.price)}</span>
                <span class="term-label">{t.label}</span>
                {t.saving && <span class="term-saving">{t.saving}</span>}
                <span class="term-check" aria-hidden="true">
                  <Icon name="check" size={16} />
                </span>
              </label>
            ))
          }
        </fieldset>
      </div>
    </section>

    <!-- E. Additional services + checkout -->
    <section class="section checkout-section">
      <div class="container checkout-grid">
        <div>
          <span class="eyebrow">Additional services</span>
          <h2>Has Something Changed With Your Plan?</h2>
          <p class="lede" style="margin-top:16px">
            Changes to your business, trustees, or plan details may require additional paperwork. Select the services you
            need, or ask our team for help identifying the appropriate service.
          </p>
          <a href="/contact/?topic=renewal-help" class="text-link" style="margin-top:16px">
            Help Me Identify the Right Service<Icon name="arrowRight" size={16} />
          </a>
          <fieldset class="services">
            <legend class="sr-only">Additional services (optional)</legend>
            {
              renewalServices.map((s) => (
                <div class="service">
                  <label class="service-main">
                    <input type="checkbox" name="services" value={s.id} data-label={s.label} data-price={s.price} />
                    <span class="service-text">
                      <strong>{s.label}</strong>
                      <span>{s.description}</span>
                    </span>
                    <span class="service-price">{money(s.price)}</span>
                  </label>
                  {s.info && (
                    <p class="service-info">
                      <Icon name="info" size={15} />
                      {s.info}
                    </p>
                  )}
                </div>
              ))
            }
          </fieldset>
        </div>

        <div class="checkout" id="checkout">
          <h2 data-checkout-title>Complete Your Plan Maintenance Renewal.</h2>

          <div class="mode" role="radiogroup" aria-label="What are you paying for?">
            <label><input type="radio" name="mode" value="renewal" checked /> Plan maintenance renewal</label>
            <label><input type="radio" name="mode" value="termination" /> Plan termination service</label>
          </div>
          <p class="mode-note" data-termination-note hidden>
            <Icon name="info" size={15} />
            This pays for the plan termination service ({money(terminationFee)}). Our team will contact you about the
            documentation and steps needed to formally terminate your plan. Your plan is not terminated until that process is
            complete.
          </p>

          <ul class="summary" data-summary aria-live="polite">
            <li><span>{defaultTerm.label}</span><span>{money(defaultTerm.price)}</span></li>
          </ul>
          <p class="fee-note" data-fee-note>Any account fees are itemized here after you verify your email.</p>
          <div class="summary-total">
            <span>Total</span>
            <strong data-total>{money(defaultTerm.price)}</strong>
          </div>

          <div class="step">
            <label for="renewal-email" class="step-label"><span>1</span>Verify your account</label>
            <div class="verify-row">
              <input id="renewal-email" type="email" autocomplete="email" class="input" placeholder="Email on your account" />
              <button type="button" class="button button-dark button-sm" data-verify>Verify</button>
            </div>
            <p class="verify-status" data-verify-status aria-live="polite"></p>
            <div class="account" data-account hidden>
              <Icon name="check" size={16} />
              <div><strong data-account-name></strong><span data-account-detail></span></div>
            </div>
          </div>

          <div class="step">
            <span class="step-label"><span>2</span>Card details</span>
            <div id="card-container" class="card-container" data-card></div>
            <p class="pay-error" data-card-error hidden role="alert"></p>
          </div>

          <div class="alert alert-error" data-pay-error hidden role="alert">
            <Icon name="circleAlert" size={18} /><span></span>
          </div>
          <button class="button checkout-button" type="submit" data-submit>
            <span data-submit-label>Complete Renewal</span><Icon name="arrowRight" size={17} />
          </button>
          <p class="checkout-note">
            <Icon name="lockKeyhole" size={15} />
            Secure payment processed by Square. Your card details go directly to Square and never touch our servers.
          </p>
          <noscript>
            <p class="checkout-note">Online payment needs JavaScript. Please call {site.phone} to renew.</p>
          </noscript>
        </div>
      </div>
    </section>
  </form>

  <!-- I. Payment confirmation (shown after a successful payment) -->
  <section class="section confirmation" data-confirmation hidden tabindex="-1">
    <div class="container">
      <div class="confirm-card">
        <span class="confirm-badge"><Icon name="check" size={16} />Payment received</span>
        <h2 data-confirm-title>Your Renewal Payment Has Been Received.</h2>
        <p data-confirm-copy>
          Thank you for renewing with The Tax Academy. Our team will process your renewal and any selected services. We
          will contact you if additional information, signatures, or documentation are required.
        </p>
        <div class="receipt">
          <h3>Receipt</h3>
          <ul data-receipt-lines></ul>
          <div class="receipt-total"><span>Total paid</span><strong data-receipt-total></strong></div>
          <dl class="receipt-meta">
            <dt>Date</dt><dd data-receipt-date></dd>
            <dt data-receipt-ref-label hidden>Payment reference</dt><dd data-receipt-ref hidden></dd>
          </dl>
          <a data-receipt-url hidden class="text-link" target="_blank" rel="noopener">View your Square receipt<Icon name="external" size={15} /></a>
        </div>
        <a href="/" class="button button-dark">Back to home</a>
      </div>
    </div>
  </section>

  <!-- F. Member learning reminder -->
  <section class="container learning">
    <div class="learning-row">
      <span class="icon-box"><Icon name="library" size={22} stroke={1.6} /></span>
      <div>
        <h2>Your Renewal Keeps Practical Learning Within Reach.</h2>
        <p>
          Continue access to attorney-reviewed explanations of common plan questions, paperwork, and annual
          responsibilities. Our learning library puts practical experience in one organized place, so you are not left
          piecing together answers on your own.
        </p>
      </div>
      <a href="/member-benefits/" class="text-link">See Member Benefits<Icon name="arrowRight" size={16} /></a>
    </div>
  </section>

  <!-- G. Renewal questions -->
  <Faq items={renewalFaqs} title="Renewal Questions" />

  <!-- H. Closing a plan -->
  <section class="section closing">
    <div class="container closing-row">
      <div>
        <span class="eyebrow">Closing a plan</span>
        <h2>Closing Your Plan? Complete the Proper Process.</h2>
        <p class="lede" style="margin-top:14px">
          Contact our team about the documentation and next steps for formally terminating your plan. Required document
          updates may still need to be completed before termination.
        </p>
        <p class="closing-fee">Plan termination service: {money(terminationFee)}</p>
      </div>
      <div class="closing-actions">
        <a href="/contact/?topic=plan-termination" class="button button-dark">
          Ask About Plan Termination<Icon name="arrowRight" size={17} />
        </a>
        <a href="#checkout" class="text-link" data-pay-termination>Pay for the termination service</a>
      </div>
    </div>
  </section>
</SiteLayout>

<script is:inline src={square.sdkUrl} async data-square-sdk></script>

<div hidden data-renewal-config data-app-id={square.appId} data-location-id={square.locationId}></div>

<script>
  import { computeCheckout, money } from '../../data/renewal';

  type Receipt = {
    termination: boolean;
    lines: { label: string; amount: number }[];
    total: number;
    date: string;
    reference: string | null;
    receiptUrl: string | null;
  };

  type LookupResponse = {
    found?: boolean;
    yearsBehind?: number;
    account?: { name: string; business: string; phoneLast4: string };
  };
  type PayResponse = { success: boolean; error?: string; receipt?: Receipt };

  const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector(sel) as T | null;
  const form = $<HTMLFormElement>('[data-renewal]')!;
  const summary = $('[data-summary]')!;
  const totalEl = $('[data-total]')!;
  const emailInput = $<HTMLInputElement>('#renewal-email')!;
  const verifyBtn = $<HTMLButtonElement>('[data-verify]')!;
  const verifyStatus = $('[data-verify-status]')!;
  const accountBox = $('[data-account]')!;
  const payError = $('[data-pay-error]')!;
  const cardError = $('[data-card-error]')!;
  const submitBtn = $<HTMLButtonElement>('[data-submit]')!;
  const submitLabel = $('[data-submit-label]')!;
  const cfg = $('[data-renewal-config]')!;

  const state = { verifiedEmail: '', yearsBehind: null as number | null };

  const selection = () => {
    const termination = (form.querySelector('input[name="mode"]:checked') as HTMLInputElement | null)?.value === 'termination';
    const termId = (form.querySelector('input[name="term"]:checked') as HTMLInputElement | null)?.value ?? '';
    const serviceIds = [...form.querySelectorAll('input[name="services"]:checked')].map((i) => (i as HTMLInputElement).value);
    return { termination, termId, serviceIds };
  };

  function render() {
    const sel = selection();
    const { lines, total } = computeCheckout({ ...sel, yearsBehind: state.yearsBehind });
    summary.replaceChildren(
      ...lines.map((l) => {
        const li = document.createElement('li');
        const a = document.createElement('span');
        const b = document.createElement('span');
        a.textContent = l.label;
        b.textContent = money(l.amount);
        li.appendChild(a);
        li.appendChild(b);
        return li;
      }),
    );
    totalEl.textContent = money(total);
    $('[data-fee-note]')!.hidden = sel.termination || state.yearsBehind !== null;
    $('[data-termination-note]')!.hidden = !sel.termination;
    $('[data-checkout-title]')!.textContent = sel.termination
      ? 'Pay for the Plan Termination Service.'
      : 'Complete Your Plan Maintenance Renewal.';
    submitLabel.textContent = sel.termination ? 'Pay Termination Service' : 'Complete Renewal';
    // Terms and services don't apply to the termination service.
    document.querySelectorAll('#renewal-options, .services').forEach((el) => el.classList.toggle('is-disabled', sel.termination));
    form.querySelectorAll('input[name="term"], input[name="services"]').forEach((i) => ((i as HTMLInputElement).disabled = sel.termination));
  }

  function showError(el: HTMLElement, message: string) {
    el.hidden = !message;
    const span = el.querySelector('span') ?? el;
    span.textContent = message;
  }

  // ---- Account verification ----
  async function verify() {
    const email = emailInput.value.trim();
    state.verifiedEmail = '';
    state.yearsBehind = null;
    accountBox.hidden = true;
    render();
    if (!email) {
      verifyStatus.textContent = 'Please enter the email on your account.';
      verifyStatus.className = 'verify-status is-error';
      return;
    }
    verifyStatus.textContent = 'Checking…';
    verifyStatus.className = 'verify-status';
    verifyBtn.disabled = true;
    try {
      const res = await fetch('/api/renewal/lookup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = (await res.json()) as LookupResponse;
      if (res.ok && data.found && data.account) {
        state.verifiedEmail = email;
        state.yearsBehind = data.yearsBehind ?? 0;
        $('[data-account-name]')!.textContent = data.account.name || 'Account verified';
        $('[data-account-detail]')!.textContent = [
          data.account.business,
          data.account.phoneLast4 && `phone ending ${data.account.phoneLast4}`,
        ]
          .filter(Boolean)
          .join(' · ');
        accountBox.hidden = false;
        showError(payError, '');
        verifyStatus.textContent = 'Account verified.';
        verifyStatus.className = 'verify-status is-ok';
      } else if (res.ok) {
        verifyStatus.innerHTML = 'No account found with this email. <a href="/contact/?topic=annual-renewal">Contact our team</a>.';
        verifyStatus.className = 'verify-status is-error';
      } else if (res.status === 503) {
        verifyStatus.textContent = 'Online renewal is temporarily unavailable. Please call us to renew.';
        verifyStatus.className = 'verify-status is-error';
      } else {
        verifyStatus.textContent = res.status === 400 ? 'Please enter a valid email address.' : 'Something went wrong. Please try again.';
        verifyStatus.className = 'verify-status is-error';
      }
    } catch {
      verifyStatus.textContent = 'Something went wrong. Please try again.';
      verifyStatus.className = 'verify-status is-error';
    } finally {
      verifyBtn.disabled = false;
      render();
    }
  }

  verifyBtn.addEventListener('click', verify);
  emailInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      verify();
    }
  });
  emailInput.addEventListener('input', () => {
    if (state.verifiedEmail && emailInput.value.trim() !== state.verifiedEmail) {
      state.verifiedEmail = '';
      state.yearsBehind = null;
      accountBox.hidden = true;
      verifyStatus.textContent = '';
      render();
    }
  });

  // ---- Square card field ----
  type SquareCard = { attach(sel: string): Promise<void>; tokenize(): Promise<{ status: string; token?: string; errors?: { message: string }[] }> };
  let card: SquareCard | null = null;

  async function initSquare() {
    const Square = (window as unknown as { Square?: { payments(app: string, loc: string): { card(opts?: object): Promise<SquareCard> } } }).Square;
    if (!Square) return false;
    try {
      const payments = Square.payments(cfg.dataset.appId!, cfg.dataset.locationId!);
      card = await payments.card({
        style: {
          input: { color: '#0e1c1f', fontSize: '15px' },
          'input::placeholder': { color: '#56666a' },
          '.input-container.is-focus': { borderColor: '#74bf44' },
          '.input-container.is-error': { borderColor: '#b42318' },
        },
      });
      await card.attach('#card-container');
      return true;
    } catch (err) {
      console.error('Square init error', err);
      showError(cardError, 'The payment form failed to load. Please refresh the page, or call us to renew.');
      return false;
    }
  }

  // The SDK loads async, so it may finish (or fail) before this script runs: wait for it
  // briefly, then report a failure instead of leaving an empty card field.
  const sdkFailed = () => showError(cardError, 'The payment form failed to load. Please refresh the page, or call us to renew.');
  const hasSquare = () => Boolean((window as unknown as { Square?: unknown }).Square);
  if (hasSquare()) initSquare();
  else {
    const sdk = document.querySelector('[data-square-sdk]');
    sdk?.addEventListener('load', () => initSquare());
    sdk?.addEventListener('error', sdkFailed);
    setTimeout(() => {
      if (!card && !hasSquare()) sdkFailed();
    }, 8000);
  }

  // ---- Payment ----
  form.addEventListener('change', (e) => {
    if ((e.target as HTMLInputElement).name !== 'email') render();
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    showError(payError, '');
    showError(cardError, '');
    const sel = selection();

    if (!state.verifiedEmail) {
      showError(payError, 'Please verify your email before completing your payment.');
      emailInput.focus();
      return;
    }
    if (!sel.termination && !sel.termId) {
      showError(payError, 'Please choose a maintenance term.');
      return;
    }
    if (!card) {
      showError(payError, 'The payment form is still loading. Please wait a moment and try again.');
      return;
    }

    submitBtn.disabled = true;
    submitLabel.textContent = 'Processing…';
    try {
      const tokenResult = await card.tokenize();
      if (tokenResult.status !== 'OK' || !tokenResult.token) {
        showError(cardError, tokenResult.errors?.map((x) => x.message).join(', ') || 'Card verification failed. Please check your card details.');
        return;
      }
      const res = await fetch('/api/renewal/pay', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: state.verifiedEmail, ...sel, sourceId: tokenResult.token }),
      });
      const data = (await res.json()) as PayResponse;
      if (data.success && data.receipt) showConfirmation(data.receipt);
      else showError(payError, data.error || 'There was a problem processing your payment. Please try again.');
    } catch (err) {
      console.error('payment error', err);
      showError(
        payError,
        'We could not confirm the result of your payment. Please check your email for a receipt before trying again, or call us.',
      );
    } finally {
      submitBtn.disabled = false;
      render();
    }
  });

  // ---- Confirmation ----
  function showConfirmation(r: Receipt) {
    const section = $('[data-confirmation]')!;
    if (r.termination) {
      $('[data-confirm-title]')!.textContent = 'Your Termination Service Payment Has Been Received.';
      $('[data-confirm-copy]')!.textContent =
        'Thank you. Our team will contact you about the documentation and next steps for formally terminating your plan. Your plan is not terminated until that process is complete.';
    }
    const list = $('[data-receipt-lines]')!;
    list.replaceChildren(
      ...r.lines.map((l) => {
        const li = document.createElement('li');
        const a = document.createElement('span');
        const b = document.createElement('span');
        a.textContent = l.label;
        b.textContent = money(l.amount);
        li.appendChild(a);
        li.appendChild(b);
        return li;
      }),
    );
    $('[data-receipt-total]')!.textContent = money(r.total);
    $('[data-receipt-date]')!.textContent = new Date(r.date).toLocaleString('en-US', { dateStyle: 'long', timeStyle: 'short' });
    if (r.reference) {
      $('[data-receipt-ref]')!.textContent = r.reference;
      $('[data-receipt-ref]')!.hidden = false;
      $('[data-receipt-ref-label]')!.hidden = false;
    }
    if (r.receiptUrl) {
      const a = $<HTMLAnchorElement>('[data-receipt-url]')!;
      a.href = r.receiptUrl;
      a.hidden = false;
    }
    form.hidden = true;
    section.hidden = false;
    section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    section.focus({ preventScroll: true });
  }

  // "Pay for the termination service" link switches the checkout mode.
  document.querySelector('[data-pay-termination]')?.addEventListener('click', () => {
    const radio = form.querySelector('input[name="mode"][value="termination"]') as HTMLInputElement | null;
    if (radio) radio.checked = true;
    render();
  });

  render();
</script>

<style>
  .hero-small {
    margin-top: 20px;
    color: var(--muted-on-dark);
    font-size: 0.9rem;
  }

  /* B. Information panel (professional, not alarming) */
  .info-panel {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 24px;
    padding: clamp(28px, 4vw, 48px);
    border-left: 4px solid var(--lime);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--cream);
  }

  .info-panel h2 {
    margin-bottom: 20px;
  }

  .info-copy {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    color: #2f3f42;
  }

  .info-statement {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 1.15rem;
    font-weight: 600;
  }

  /* C. Benefits */
  .includes {
    padding-top: 0;
  }

  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .benefit-grid .icon-box {
    margin-bottom: 18px;
  }

  .muted-line {
    margin-top: 20px;
    color: var(--muted);
    font-size: 0.95rem;
  }

  /* D. Terms */
  #renewal-options {
    background: var(--cream);
    scroll-margin-top: 16px;
  }

  .terms {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .term {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
