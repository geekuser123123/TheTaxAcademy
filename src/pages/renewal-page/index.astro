---
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../components/icons';
import { renewalFaqs } from '../../data/faqs';
import { money, renewalServices, renewalTerms, square, terminationFee } from '../../data/renewal';
import { experience, site } from '../../data/site';

const oneYear = renewalTerms.find((t) => t.years === 1)!;
const saving = (years: number, price: number) => years * oneYear.price - price;
const perYear = (years: number, price: number) =>
  `$${(price / years).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} / year`;
const defaultTerm = renewalTerms[0];

const included: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'fileCheck',
    title: 'Plan Document Maintenance',
    text: 'Continued maintenance of your plan documentation within the annual service scope.',
  },
  {
    icon: 'refreshCw',
    title: 'Required Document Updates',
    text: 'Applicable updates covered by your service, with instructions for information or signatures needed from you.',
  },
  {
    icon: 'clipboardCheck',
    title: 'Administrative Support',
    text: 'Assistance with routine documentation questions and identifying appropriate next steps.',
  },
  {
    icon: 'library',
    title: 'Member Learning Access',
    text: 'Continued access to practical, attorney-reviewed educational resources.',
  },
];

const whyItems = [
  'Applicable amendments and restatements must be completed as requirements change.',
  'Missing required document updates can jeopardize the plan’s tax-qualified status and require corrective work.',
  'Losing tax-favored treatment can also affect contribution deductions and rollover eligibility.',
];
---

<SiteLayout
  title="Renew Your Plan Maintenance | The Tax Academy"
  description="Annual renewal keeps your Tax Academy document maintenance, required-update service, administrative support, and member learning access active."
>
  <div class="rn">
    <!-- A. Hero -->
    <section class="rn-hero">
      <div class="container rn-hero-inner">
        <div>
          <div class="rn-eyebrow">Plan maintenance renewal</div>
          <h1>Renew Your Plan Maintenance. <em>Keep Required Updates on Track.</em></h1>
          <p class="rn-hero-sub">
            Annual renewal is required to continue your Tax Academy document maintenance, required-update service,
            administrative support, and member learning access.
          </p>
          <p class="rn-hero-sub">Keep the support behind your plan active as retirement-plan requirements evolve.</p>
          <div class="rn-hero-ctas">
            <a href="#renewal-options" class="rn-btn rn-btn-lg">Choose My Renewal Term</a>
            <a href="#closing" class="rn-link-quiet">Closing your plan instead?</a>
          </div>
          <div class="rn-trust">
            <span class="rn-trust-item"><span class="rn-trust-check"><Icon name="check" size={10} stroke={3} /></span>{experience}</span>
            <span class="rn-trust-item"><span class="rn-trust-check"><Icon name="check" size={10} stroke={3} /></span>Secure card payment by Square</span>
          </div>
        </div>
        <div class="rn-hero-card">
          <div class="rn-card-label">Included with renewal</div>
          <div class="rn-hero-card-title">What Your Renewal Keeps Active</div>
          {
            included.map((i) => (
              <div class="rn-hero-feature">
                <span class="rn-dot" />
                {i.title}
              </div>
            ))
          }
          <div class="rn-pill">Included with every active maintenance term</div>
        </div>
      </div>
    </section>

    <!-- C. What renewal includes + F. learning reminder -->
    <section class="rn-section rn-white">
      <div class="container">
        <div class="rn-label">What you get</div>
        <div class="rn-included-grid">
          <div>
            <h2 class="rn-title">What Your Renewal Keeps Active.</h2>
            <p class="rn-sub" style="margin-bottom:32px">
              Individual plan changes, filing assistance, and other additional work are listed separately below.
            </p>
            <div class="rn-included-list">
              {
                included.map((i) => (
                  <div class="rn-included-item">
                    <span class="rn-included-icon">
                      <Icon name={i.icon} size={17} stroke={1.8} />
                    </span>
                    <div>
                      <strong>{i.title}</strong>
                      <span>{i.text}</span>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
          <div class="rn-course-card">
            <div class="rn-card-label rn-green">Member learning</div>
            <h3>Your Renewal Keeps Practical Learning Within Reach.</h3>
            <p>
              Continue access to attorney-reviewed explanations of common plan questions, paperwork, and annual
              responsibilities. Our learning library puts practical experience in one organized place, so you are not
              left piecing together answers on your own.
            </p>
            <div class="rn-course-features">
              <div>Common plan questions, explained</div>
              <div>Paperwork and annual responsibilities</div>
              <div>Practical, attorney-reviewed resources</div>
            </div>
            <a href="/member-benefits/" class="rn-pill rn-pill-link">See Member Benefits <Icon name="arrowRight" size={13} /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- Statement strip -->
    <div class="rn-strip">
      <p>Keep your maintenance current <strong>instead of waiting for a document problem to surface.</strong></p>
    </div>

    <!-- D. Renewal options -->
    <section class="rn-section rn-white" id="renewal-options">
      <div class="container">
        <div class="rn-label">Choose your term</div>
        <h2 class="rn-title">Select Your Maintenance Term.</h2>
        <p class="rn-sub">
          Keep your annual maintenance active for one, two, or three years. Multi-year options prepay the selected
          maintenance period.
        </p>
        <div class="rn-pricing-grid" role="radiogroup" aria-label="Maintenance term">
          {
            renewalTerms.map((t) => (
              <button
                type="button"
                role="radio"
                aria-checked={t.id === defaultTerm.id ? 'true' : 'false'}
                class:list={['rn-price-card', { 'is-featured': t.badge, 'is-selected': t.id === defaultTerm.id }]}
                data-term={t.id}
              >
                {t.badge && <span class="rn-price-badge">{t.badge}</span>}
                <span class="rn-radio" />
                <span class="rn-price-term">
                  {t.years} {t.years === 1 ? 'Year' : 'Years'}
                </span>
                <span class="rn-price-amount">{money(t.price)}</span>
                <span class="rn-price-save">{saving(t.years, t.price) > 0 ? `Save ${money(saving(t.years, t.price))}` : ' '}</span>
                <span class="rn-price-hint">{t.years === 1 ? 'Standard annual term' : perYear(t.years, t.price)}</span>
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <!-- E. Additional services -->
    <section class="rn-section rn-pale" id="additional-services">
      <div class="container">
        <div class="rn-label">Additional services</div>
        <h2 class="rn-title">Has Something Changed With Your Plan?</h2>
        <p class="rn-sub">
          Changes to your business, trustees, or plan details may require additional paperwork. Select the services you
          need, or ask our team for help identifying the appropriate service.
        </p>
        <div class="rn-addons-grid">
          {
            renewalServices.map((s) => (
              <div class="rn-addon-wrap">
                <button type="button" role="checkbox" aria-checked="false" class="rn-addon" data-service={s.id}>
                  <span class="rn-check" />
                  <span class="rn-addon-name">{s.label}</span>
                  <span class="rn-addon-price">{money(s.price)}</span>
                  <span class="rn-addon-desc">{s.description}</span>
                </button>
                {s.info && (
                  <span class="rn-tip" tabindex="0" aria-label={`About ${s.label}`}>
                    ?<span class="rn-tip-text" role="tooltip">{s.info}</span>
                  </span>
                )}
              </div>
            ))
          }
        </div>
        <div class="rn-hint">
          Not sure which service applies?{' '}
          <a href="/contact/?topic=renewal-help">Help Me Identify the Right Service →</a>
        </div>
      </div>
    </section>

    <!-- B. Why maintenance matters -->
    <section class="rn-why">
      <div class="container rn-why-grid">
        <div>
          <div class="rn-label rn-label-dim">Why it matters</div>
          <h2 class="rn-why-title">Your Plan’s Requirements Continue After Setup.</h2>
          <p class="rn-why-sub">A retirement plan is not finished when the original documents are signed.</p>
        </div>
        <ul class="rn-why-list">
          {
            whyItems.map((t) => (
              <li>
                <span class="rn-why-icon">
                  <Icon name="info" size={15} stroke={2} />
                </span>
                <p>{t}</p>
              </li>
            ))
          }
          <li class="rn-why-statement">
            <span class="rn-why-icon is-green">
              <Icon name="check" size={15} stroke={2.4} />
            </span>
            <p>Keeping your Tax Academy renewal current keeps our maintenance and update service in place.</p>
          </li>
        </ul>
      </div>
    </section>

    <!-- H. Closing a plan -->
    <section class="rn-section rn-pale" id="closing">
      <div class="container">
        <div class="rn-label">Closing a plan</div>
        <h2 class="rn-title">Closing Your Plan? Complete the Proper Process.</h2>
        <p class="rn-sub">
          Contact our team about the documentation and next steps for formally terminating your plan. Required document
          updates may still need to be completed before termination.
        </p>
        <button type="button" class="rn-cancel-card" aria-pressed="false" data-termination-card>
          <span class="rn-cancel-head">
            <span class="rn-cancel-left">
              <span class="rn-check rn-check-red" />
              <span>
                <span class="rn-cancel-title">Plan Termination Service</span>
                <span class="rn-cancel-sub">
                  Our team will contact you about the documentation and steps needed to formally terminate your plan. Your
                  plan is not terminated until that process is complete.
                </span>
              </span>
            </span>
            <span class="rn-cancel-price">{money(terminationFee)}</span>
          </span>
        </button>
        <p class="rn-cancel-note">
          <Icon name="info" size={15} />
          <span>
            Cancelling your maintenance service is not the same as terminating your plan. Terminating a plan requires its
            own documentation and steps. Selecting this service pays for termination instead of a renewal.
          </span>
        </p>
        <a href="/contact/?topic=plan-termination" class="rn-text-link">Ask About Plan Termination →</a>
      </div>
    </section>

    <!-- G. Renewal questions -->
    <section class="rn-section rn-white">
      <div class="container">
        <div class="rn-label">Common questions</div>
        <h2 class="rn-title">Renewal Questions</h2>
        <div class="rn-faq">
          {
            renewalFaqs.map((f) => (
              <details>
                <summary>
                  {f.q}
                  <span class="rn-faq-icon">+</span>
                </summary>
                <div class="rn-faq-answer">
                  {f.a.map((p) => (
                    <p>{p}</p>
                  ))}
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="rn-final">
      <div class="container">
        <h2>Keep Required Updates on Track.</h2>
        <p>
          Renew to continue document maintenance, required updates, administrative support, and member learning access.
        </p>
        <button type="button" class="rn-btn rn-btn-xl" data-open-checkout>Complete My Renewal</button>
        <div class="rn-final-sub">Secure card payment by Square · Itemized total before you pay</div>
        <noscript><p class="rn-final-sub">Online payment needs JavaScript. Please call {site.phone} to renew.</p></noscript>
      </div>
    </section>

    <!-- Sticky selection bar -->
    <div class="rn-sticky" data-sticky aria-hidden="true">
      <div class="rn-sticky-summary">
        <div class="rn-sticky-label">Your current selection</div>
        <div class="rn-sticky-total"><span data-sticky-total>{money(defaultTerm.price)}</span><small data-sticky-note> + account fee, if any</small></div>
      </div>
      <div class="rn-sticky-right">
        <div class="rn-sticky-selection" data-sticky-selection>{defaultTerm.label}</div>
        <button type="button" class="rn-btn" data-open-checkout tabindex="-1">Continue to Checkout →</button>
      </div>
    </div>

    <!-- Checkout modal -->
    <div class="rn-modal-overlay" data-modal hidden>
      <div class="rn-modal" role="dialog" aria-modal="true" aria-labelledby="rn-modal-title">
        <div class="rn-modal-header">
          <div>
            <h2 class="rn-modal-title" id="rn-modal-title" data-modal-title>Complete Your Plan Maintenance Renewal</h2>
            <p class="rn-modal-sub">Verify your account, review your itemized total, and pay securely by card.</p>
          </div>
          <button type="button" class="rn-modal-close" data-close-checkout aria-label="Close checkout">
            <Icon name="x" size={18} />
          </button>
        </div>
        <div class="rn-modal-body">
          <div class="rn-modal-left">
            <div class="rn-msec" data-renewal-only>
              <div class="rn-msec-label">Maintenance term</div>
              <div class="rn-mlist" role="radiogroup" aria-label="Maintenance term">
                {
                  renewalTerms.map((t) => (
                    <button
                      type="button"
                      role="radio"
                      aria-checked={t.id === defaultTerm.id ? 'true' : 'false'}
                      class:list={['rn-mopt', { 'is-selected': t.id === defaultTerm.id }]}
                      data-term={t.id}
                    >
                      <span class="rn-radio" />
                      <span class="rn-mopt-info">
                        <span class="rn-mopt-name">
                          {t.years} {t.years === 1 ? 'Year' : 'Years'}
                          {t.badge && ` — ${t.badge}`}
                        </span>
                        {saving(t.years, t.price) > 0 && <span class="rn-mopt-save">Save {money(saving(t.years, t.price))}</span>}
                      </span>
                      <span class="rn-mopt-price">{money(t.price)}</span>
                    </button>
                  ))
                }
              </div>
            </div>

            <div class="rn-msec" data-renewal-only>
              <div class="rn-msec-label">Additional services (optional)</div>
              <div class="rn-mlist">
                {
                  renewalServices.map((s) => (
                    <button type="button" role="checkbox" aria-checked="false" class="rn-mopt" data-service={s.id}>
                      <span class="rn-check" />
                      <span class="rn-mopt-info">
                        <span class="rn-mopt-name">{s.label}</span>
                        <span class="rn-mopt-desc">{s.description}</span>
                      </span>
                      <span class="rn-mopt-price">{money(s.price)}</span>
                    </button>
                  ))
                }
              </div>
            </div>

            <div class="rn-msec">
              <div class="rn-msec-label">Closing your plan instead?</div>
              <button type="button" class="rn-mopt rn-mopt-red" aria-pressed="false" data-termination-card>
                <span class="rn-check rn-check-red" />
                <span class="rn-mopt-info">
                  <span class="rn-mopt-name">Plan Termination Service</span>
                  <span class="rn-mopt-desc">Paid on its own, instead of a renewal.</span>
                </span>
                <span class="rn-mopt-price">{money(terminationFee)}</span>
              </button>
              <p class="rn-mnote" data-termination-note hidden>
                Our team will contact you about the documentation and steps needed to formally terminate your plan. Your
                plan is not terminated until that process is complete.
              </p>
            </div>

            <div class="rn-msec">
              <div class="rn-msec-label">Your information</div>
              <label class="rn-mform-label" for="rn-email">Email on your account</label>
              <div class="rn-verify-row">
                <input id="rn-email" class="rn-input" type="email" autocomplete="email" placeholder="you@example.com" />
                <button type="button" class="rn-btn rn-btn-sm" data-verify>Verify</button>
              </div>
              <p class="rn-verify-status" data-verify-status aria-live="polite"></p>
              <div class="rn-account" data-account hidden>
                <span class="rn-trust-check"><Icon name="check" size={10} stroke={3} /></span>
                <div><strong data-account-name></strong><span data-account-detail></span></div>
              </div>
            </div>

            <div class="rn-msec">
              <div class="rn-msec-label">Payment</div>
              <div class="rn-card-icons" aria-hidden="true">
                <span>VISA</span><span>MC</span><span>AMEX</span><span>DISC</span>
              </div>
              <label class="rn-mform-label">Card details</label>
              <div id="card-container" class="rn-card-container"></div>
              <p class="rn-error" data-card-error hidden role="alert"></p>
            </div>

            <div>
              <p class="rn-error" data-pay-error hidden role="alert"></p>
              <button type="button" class="rn-submit" data-submit>
                <span data-submit-label>Complete Renewal</span>
              </button>
              <div class="rn-submit-sub">
                <Icon name="lockKeyhole" size={13} /> Secure payment · Powered by Square. Card details go directly to Square.
              </div>
            </div>
          </div>

          <aside class="rn-modal-right" aria-label="Order summary">
            <div class="rn-order-title">Your Order</div>
            <div data-order-lines aria-live="polite"></div>
            <p class="rn-fee-note" data-fee-note>Any account fee is itemized here after you verify your email.</p>
            <div class="rn-order-total">
              <span>Total</span>
              <strong data-order-total>{money(defaultTerm.price)}</strong>
            </div>
            <div class="rn-order-box rn-order-box-green" data-renewal-only>
              <div class="rn-order-box-label">Included with renewal</div>
              <div>Member learning access</div>
              <small>Continues throughout your active maintenance term.</small>
            </div>
            <div class="rn-order-box">
              <div class="rn-order-box-label">What happens next</div>
              <ol class="rn-next" data-next-steps>
                <li>We process your renewal and any selected services.</li>
                <li>We contact you if information, signatures, or documentation are needed.</li>
              </ol>
            </div>
          </aside>
        </div>
      </div>
    </div>

    <!-- I. Confirmation -->
    <div class="rn-confirm" data-confirmation hidden tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="rn-confirm-title">
      <div class="rn-confirm-nav">
        <img src="/images/tax-academy-logo.png" alt="" width="42" height="42" />
        <span>{site.legalName}</span>
      </div>
      <div class="rn-confirm-body">
        <span class="rn-confirm-badge"><span class="rn-confirm-check"><Icon name="check" size={12} stroke={3} /></span>Payment received</span>
        <h2 class="rn-confirm-title" id="rn-confirm-title" data-confirm-title>Your Renewal Payment Has Been Received.</h2>
        <p class="rn-confirm-sub" data-confirm-copy>
          Thank you for renewing with The Tax Academy. Our team will process your renewal and any selected services. We
          will contact you if additional information, signatures, or documentation are required.
        </p>
        <div class="rn-confirm-card">
          <div class="rn-confirm-card-title">Order summary</div>
          <div data-receipt-lines></div>
          <div class="rn-confirm-total"><span>Total paid</span><strong data-receipt-total></strong></div>
          <dl class="rn-confirm-meta">
            <dt>Date</dt><dd data-receipt-date></dd>
            <dt data-receipt-ref-label hidden>Payment reference</dt><dd data-receipt-ref hidden></dd>
          </dl>
          <a data-receipt-url hidden class="rn-text-link" target="_blank" rel="noopener">View your Square receipt →</a>
        </div>
        <div class="rn-confirm-next">
          <div class="rn-confirm-next-title">What happens next</div>
          <ol data-confirm-steps>
            <li>We process your renewal and any selected services.</li>
            <li>We contact you if information, signatures, or documentation are needed.</li>
          </ol>
        </div>
        <a href="/" class="rn-btn rn-btn-lg">Back to home</a>
      </div>
    </div>

    <div hidden data-renewal-config data-app-id={square.appId} data-location-id={square.locationId} data-sdk={square.sdkUrl}></div>
  </div>
</SiteLayout>

<script>
  import { computeCheckout, money, renewalTerms } from '../../data/renewal';

  type Receipt = {
    termination: boolean;
    lines: { label: string; amount: number }[];
    total: number;
    date: string;
    reference: string | null;
    receiptUrl: string | null;
  };
  type LookupResponse = {
    found?: boolean;
    yearsBehind?: number;
    account?: { name: string; business: string; phoneLast4: string };
  };
  type PayResponse = { success: boolean; error?: string; receipt?: Receipt };
  type SquareCard = {
    attach(sel: string): Promise<void>;
    tokenize(): Promise<{ status: string; token?: string; errors?: { message: string }[] }>;
  };
  type SquareGlobal = { payments(app: string, loc: string): { card(opts?: object): Promise<SquareCard> } };

  const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector(sel) as T | null;
  const $$ = (sel: string) => [...document.querySelectorAll(sel)] as HTMLElement[];

  const cfg = $('[data-renewal-config]')!;
  const modal = $('[data-modal]')!;
  const sticky = $('[data-sticky]')!;
  const emailInput = $<HTMLInputElement>('#rn-email')!;
  const verifyBtn = $<HTMLButtonElement>('[data-verify]')!;
  const verifyStatus = $('[data-verify-status]')!;
  const accountBox = $('[data-account]')!;
  const payError = $('[data-pay-error]')!;
  const cardError = $('[data-card-error]')!;
  const submitBtn = $<HTMLButtonElement>('[data-submit]')!;
  const submitLabel = $('[data-submit-label]')!;

  const state = {
    termId: renewalTerms[0].id,
    services: new Set<string>(),
    termination: false,
    verifiedEmail: '',
    yearsBehind: null as number | null,
  };

  const renewalSteps = [
    'We process your renewal and any selected services.',
    'We contact you if information, signatures, or documentation are needed.',
  ];
  const terminationSteps = [
    'Our team contacts you about the documentation and steps needed to formally terminate your plan.',
    'Your plan is not terminated until that process is complete.',
  ];

  function lineRows(lines: { label: string; amount: number }[], cls: string) {
    return lines.map((l) => {
      const row = document.createElement('div');
      row.className = cls;
      const a = document.createElement('span');
      const b = document.createElement('span');
      a.textContent = l.label;
      b.textContent = money(l.amount);
      row.appendChild(a);
      row.appendChild(b);
      return row;
    });
  }

  function listItems(steps: string[]) {
    return steps.map((s) => {
      const li = document.createElement('li');
      li.textContent = s;
      return li;
    });
  }

  function render() {
    const { lines, total } = computeCheckout({
      termId: state.termId,
      serviceIds: [...state.services],
      termination: state.termination,
      yearsBehind: state.yearsBehind,
    });

    $$('[data-term]').forEach((el) => {
      const on = el.dataset.term === state.termId;
      el.classList.toggle('is-selected', on);
      el.setAttribute('aria-checked', String(on));
      el.classList.toggle('is-disabled', state.termination);
      (el as HTMLButtonElement).disabled = state.termination;
    });
    $$('[data-service]').forEach((el) => {
      const on = state.services.has(el.dataset.service!);
      el.classList.toggle('is-selected', on);
      el.setAttribute('aria-checked', String(on));
      el.classList.toggle('is-disabled', state.termination);
      (el as HTMLButtonElement).disabled = state.termination;
    });
    $$('[data-termination-card]').forEach((el) => {
      el.classList.toggle('is-selected', state.termination);
      el.setAttribute('aria-pressed', String(state.termination));
    });
    $$('[data-renewal-only]').forEach((el) => (el.hidden = state.termination));
    $('[data-termination-note]')!.hidden = !state.termination;

    $('[data-order-lines]')!.replaceChildren(...lineRows(lines, 'rn-order-line'));
    $('[data-order-total]')!.textContent = money(total);
    $('[data-fee-note]')!.hidden = state.termination || state.yearsBehind !== null;
    $('[data-next-steps]')!.replaceChildren(...listItems(state.termination ? terminationSteps : renewalSteps));
    $('[data-modal-title]')!.textContent = state.termination
      ? 'Pay for the Plan Termination Service'
      : 'Complete Your Plan Maintenance Renewal';
    if (!submitBtn.disabled) {
      submitLabel.textContent = state.termination ? `Pay Termination Service — ${money(total)}` : `Complete Renewal — ${money(total)}`;
    }

    $('[data-sticky-total]')!.textContent = money(total);
    $('[data-sticky-note]')!.hidden = state.termination || state.yearsBehind !== null;
    const term = renewalTerms.find((t) => t.id === state.termId);
    $('[data-sticky-selection]')!.textContent = state.termination
      ? 'Plan Termination Service'
      : [term?.label, state.services.size ? `+ ${state.services.size} service${state.services.size > 1 ? 's' : ''}` : '']
          .filter(Boolean)
          .join(' ');
  }

  function showError(el: HTMLElement, message: string) {
    el.hidden = !message;
    el.textContent = message;
  }

  // ---- Selection (page cards and checkout options share one state) ----
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const term = target.closest<HTMLElement>('[data-term]');
    const service = target.closest<HTMLElement>('[data-service]');
    const termination = target.closest<HTMLElement>('[data-termination-card]');
    if (term && !state.termination) state.termId = term.dataset.term!;
    else if (service && !state.termination) {
      const id = service.dataset.service!;
      if (state.services.has(id)) state.services.delete(id);
      else state.services.add(id);
    } else if (termination) state.termination = !state.termination;
    else return;
    render();
  });

  // ---- Checkout modal ----
  let lastFocus: HTMLElement | null = null;
  let squareStarted = false;

  function openCheckout() {
    lastFocus = document.activeElement as HTMLElement | null;
    modal.hidden = false;
    document.body.classList.add('rn-locked');
    requestAnimationFrame(() => modal.classList.add('is-open'));
    if (!squareStarted) {
      squareStarted = true;
      loadSquare();
    }
    (state.verifiedEmail ? submitBtn : emailInput).focus({ preventScroll: true });
  }

  function closeCheckout() {
    modal.classList.remove('is-open');
    modal.hidden = true;
    document.body.classList.remove('rn-locked');
    lastFocus?.focus({ preventScroll: true });
  }

  $$('[data-open-checkout]').forEach((b) => b.addEventListener('click', openCheckout));
  $('[data-close-checkout]')!.addEventListener('click', closeCheckout);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeCheckout();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.hidden && !submitBtn.disabled) closeCheckout();
  });

  // ---- Sticky bar ----
  const onScroll = () => {
    const show = window.scrollY > 500;
    sticky.classList.toggle('is-visible', show);
    sticky.setAttribute('aria-hidden', String(!show));
    sticky.querySelector('button')!.tabIndex = show ? 0 : -1;
    document.body.classList.toggle('rn-has-sticky', show);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // ---- Account verification ----
  async function verify() {
    const email = emailInput.value.trim();
    state.verifiedEmail = '';
    state.yearsBehind = null;
    accountBox.hidden = true;
    render();
    if (!email) {
      verifyStatus.textContent = 'Please enter the email on your account.';
      verifyStatus.className = 'rn-verify-status is-error';
      return;
    }
    verifyStatus.textContent = 'Checking…';
    verifyStatus.className = 'rn-verify-status';
    verifyBtn.disabled = true;
    try {
      const res = await fetch('/api/renewal/lookup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = (await res.json()) as LookupResponse;
      if (res.ok && data.found && data.account) {
        state.verifiedEmail = email;
        state.yearsBehind = data.yearsBehind ?? 0;
        $('[data-account-name]')!.textContent = data.account.name || 'Account verified';
        $('[data-account-detail]')!.textContent = [
          data.account.business,
          data.account.phoneLast4 && `phone ending ${data.account.phoneLast4}`,
        ]
          .filter(Boolean)
          .join(' · ');
        accountBox.hidden = false;
        showError(payError, '');
        verifyStatus.textContent = 'Account verified.';
        verifyStatus.className = 'rn-verify-status is-ok';
      } else if (res.ok) {
        verifyStatus.innerHTML = 'No account found with this email. <a href="/contact/?topic=annual-renewal">Contact our team</a>.';
        verifyStatus.className = 'rn-verify-status is-error';
      } else if (res.status === 503) {
        verifyStatus.textContent = 'Online renewal is temporarily unavailable. Please call us to renew.';
        verifyStatus.className = 'rn-verify-status is-error';
      } else {
        verifyStatus.textContent = res.status === 400 ? 'Please enter a valid email address.' : 'Something went wrong. Please try again.';
        verifyStatus.className = 'rn-verify-status is-error';
      }
    } catch {
      verifyStatus.textContent = 'Something went wrong. Please try again.';
      verifyStatus.className = 'rn-verify-status is-error';
    } finally {
      verifyBtn.disabled = false;
      render();
    }
  }

  verifyBtn.addEventListener('click', verify);
  emailInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      verify();
    }
  });
  emailInput.addEventListener('input', () => {
    if (state.verifiedEmail && emailInput.value.trim() !== state.verifiedEmail) {
      state.verifiedEmail = '';
      state.yearsBehind = null;
      accountBox.hidden = true;
      verifyStatus.textContent = '';
      render();
    }
  });

  // ---- Square card field (loaded when checkout first opens) ----
  let card: SquareCard | null = null;
  const sdkFailed = () => showError(cardError, 'The payment form failed to load. Please refresh the page, or call us to renew.');
  const getSquare = () => (window as unknown as { Square?: SquareGlobal }).Square;

  async function initSquare() {
    const Square = getSquare();
    if (!Square) return sdkFailed();
    try {
      const payments = Square.payments(cfg.dataset.appId!, cfg.dataset.locationId!);
      card = await payments.card({
        style: {
          input: { color: '#001d21', fontSize: '15px' },
          'input::placeholder': { color: '#4a6b6f' },
          '.input-container.is-focus': { borderColor: '#7abc32' },
          '.input-container.is-error': { borderColor: '#e24b4a' },
        },
      });
      await card.attach('#card-container');
    } catch (err) {
      console.error('Square init error', err);
      sdkFailed();
    }
  }

  function loadSquare() {
    if (getSquare()) return void initSquare();
    const s = document.createElement('script');
    s.src = cfg.dataset.sdk!;
    s.async = true;
    s.addEventListener('load', () => initSquare());
    s.addEventListener('error', sdkFailed);
    document.head.appendChild(s);
    setTimeout(() => {
      if (!card && !getSquare()) sdkFailed();
    }, 8000);
  }

  // ---- Payment ----
  submitBtn.addEventListener('click', async () => {
    showError(payError, '');
    showError(cardError, '');

    if (!state.verifiedEmail) {
      showError(payError, 'Please verify your email before completing your payment.');
      emailInput.focus();
      return;
    }
    if (!card) {
      showError(payError, 'The payment form is still loading. Please wait a moment and try again.');
      return;
    }

    submitBtn.disabled = true;
    submitLabel.textContent = 'Processing…';
    try {
      const tokenResult = await card.tokenize();
      if (tokenResult.status !== 'OK' || !tokenResult.token) {
        showError(cardError, tokenResult.errors?.map((x) => x.message).join(', ') || 'Card verification failed. Please check your card details.');
        return;
      }
      const res = await fetch('/api/renewal/pay', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: state.verifiedEmail,
          termId: state.termId,
          serviceIds: [...state.services],
          termination: state.termination,
          sourceId: tokenResult.token,
        }),
      });
      const data = (await res.json()) as PayResponse;
      if (data.success && data.receipt) showConfirmation(data.receipt);
      else showError(payError, data.error || 'There was a problem processing your payment. Please try again.');
    } catch (err) {
      console.error('payment error', err);
      showError(
        payError,
        'We could not confirm the result of your payment. Please check your email for a receipt before trying again, or call us.',
      );
    } finally {
      submitBtn.disabled = false;
      render();
    }
  });

  // ---- Confirmation ----
  function showConfirmation(r: Receipt) {
    const overlay = $('[data-confirmation]')!;
    if (r.termination) {
      $('[data-confirm-title]')!.textContent = 'Your Termination Service Payment Has Been Received.';
      $('[data-confirm-copy]')!.textContent =
        'Thank you. Our team will contact you about the documentation and next steps for formally terminating your plan. Your plan is not terminated until that process is complete.';
      $('[data-confirm-steps]')!.replaceChildren(...listItems(terminationSteps));
    }
    $('[data-receipt-lines]')!.replaceChildren(...lineRows(r.lines, 'rn-confirm-line'));
    $('[data-receipt-total]')!.textContent = money(r.total);
    $('[data-receipt-date]')!.textContent = new Date(r.date).toLocaleString('en-US', { dateStyle: 'long', timeStyle: 'short' });
    if (r.reference) {
      $('[data-receipt-ref]')!.textContent = r.reference;
      $('[data-receipt-ref]')!.hidden = false;
      $('[data-receipt-ref-label]')!.hidden = false;
    }
    if (r.receiptUrl) {
      const a = $<HTMLAnchorElement>('[data-receipt-url]')!;
      a.href = r.receiptUrl;
      a.hidden = false;
    }
    modal.classList.remove('is-open');
    modal.hidden = true;
    sticky.hidden = true;
    overlay.hidden = false;
    document.body.classList.add('rn-locked');
    overlay.focus({ preventScroll: true });
  }

  render();
</script>

