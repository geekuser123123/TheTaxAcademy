---
// Shown after a renewal request. No payment is taken on the site yet, so this page
// confirms the request and next steps; it must not claim that a payment was received.
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { renewalServices, renewalTerms } from '../../data/renewal';

const prices = {
  terms: renewalTerms.map(({ id, label, price }) => ({ id, label, price })),
  services: renewalServices.map(({ id, label, price }) => ({ id, label, price })),
};
---

<SiteLayout title="Renewal Request Received | The Tax Academy" noindex>
  <PageHero
    eyebrow="Renew my plan"
    title="Your renewal request has been received."
    lede="Thank you for renewing with The Tax Academy. Our team will confirm your account and send secure payment instructions for your selection. We will contact you if additional information, signatures, or documentation are required."
  />
  <section class="section" data-prices={JSON.stringify(prices)}>
    <div class="container">
      <div class="selection" data-selection hidden>
        <h2>Your selection</h2>
        <ul data-lines></ul>
        <div class="total"><span>Total</span><strong data-total></strong></div>
      </div>
      <a href="/" class="button button-dark" style="margin-top:28px">Back to home</a>
    </div>
  </section>
</SiteLayout>

<script>
  type Item = { id: string; label: string; price: number };
  const holder = document.querySelector<HTMLElement>('[data-prices]');
  const params = new URLSearchParams(location.search);
  if (holder) {
    const { terms, services } = JSON.parse(holder.dataset.prices!) as { terms: Item[]; services: Item[] };
    const term = terms.find((t) => t.id === params.get('term'));
    const picked = services.filter((s) => (params.get('services') ?? '').split(',').includes(s.id));
    if (term) {
      const items = [term, ...picked];
      const money = (n: number) => `$${n.toLocaleString('en-US')}`;
      const list = holder.querySelector('[data-lines]')!;
      for (const item of items) {
        const li = document.createElement('li');
        const a = document.createElement('span');
        const b = document.createElement('span');
        a.textContent = item.label;
        b.textContent = money(item.price);
        li.appendChild(a);
        li.appendChild(b);
        list.appendChild(li);
      }
      holder.querySelector('[data-total]')!.textContent = money(items.reduce((s, i) => s + i.price, 0));
      holder.querySelector<HTMLElement>('[data-selection]')!.hidden = false;
    }
  }
</script>

<style>
  .selection {
    max-width: 520px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .selection h2 {
    font-size: 1.2rem;
    margin-bottom: 16px;
  }
  .selection ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0 0 16px;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }
  .selection :global(li) {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .total {
    display: flex;
    justify-content: space-between;
    padding-top: 16px;
    font-weight: 600;
  }
</style>
