---
import Icon from './Icon.astro';
import { site, footerNav, footerDescription, disclaimer } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <p>{footerDescription}</p>
        <div class="footer-contact">
          <a href={site.phoneHref}><Icon name="phone" size={16} />{site.phone}</a>
          {site.email && <a href={`mailto:${site.email}`}><Icon name="mail" size={16} />{site.email}</a>}
          <span><Icon name="mapPin" size={16} />{site.address.line1}<br />{site.address.line2}</span>
        </div>
      </div>
      <nav class="footer-links" aria-label="Footer navigation">
        {footerNav.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <div class="footer-secondary">
        <h3>Other services</h3>
        <a href="/contact/?topic=statutory-agent">Statutory Agent Services</a>
      </div>
    </div>

    <div class="footer-wordmark" aria-hidden="true">
      <svg viewBox="0 0 1000 86" preserveAspectRatio="xMidYMid meet">
        <text x="0" y="78" textLength="1000" lengthAdjust="spacingAndGlyphs">THE TAX ACADEMY</text>
      </svg>
    </div>

    <div class="footer-bottom">
      <span>© {year} {site.legalName}</span>
    </div>
    <p class="footer-fine">{disclaimer}</p>
  </div>
</footer>
