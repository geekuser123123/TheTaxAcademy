---
import Icon from './Icon.astro';
import { site, footerNav, disclaimer } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" aria-label={`${site.name} home`}>
          <img src="/images/seal.png" alt="" width="76" height="76" />
        </a>
        <p>Your home base for existing-plan support, helpful resources, and your next step.</p>
        <div class="footer-contact">
          <a href={site.phoneHref}><Icon name="phone" size={16} />{site.phone}</a>
          {site.email && <a href={`mailto:${site.email}`}><Icon name="mail" size={16} />{site.email}</a>}
          <span><Icon name="mapPin" size={16} />{site.address.line1}<br />{site.address.line2}</span>
        </div>
      </div>
      {
        footerNav.map((col) => (
          <div class="footer-col">
            <h3>{col.title}</h3>
            {col.links.map((l) => <a href={l.href}>{l.label}</a>)}
          </div>
        ))
      }
      <div class="footer-col">
        <h3>Your client space</h3>
        <a href="/portal">Client portal<Icon name="arrowUpRight" size={13} /></a>
        <a href="/portal/documents">Private documents</a>
        <a href="/forms/contact-team">Portal access help</a>
        {
          site.rothAcademyUrl && (
            <a href={site.rothAcademyUrl}>
              Establish a new plan<Icon name="arrowUpRight" size={13} />
            </a>
          )
        }
      </div>
    </div>

    <div class="footer-wordmark" aria-hidden="true">
      <svg viewBox="0 0 1000 86" preserveAspectRatio="xMidYMid meet">
        <text x="0" y="78" textLength="1000" lengthAdjust="spacingAndGlyphs">THE TAX ACADEMY</text>
      </svg>
    </div>

    <div class="footer-bottom">
      <span>© {year} {site.legalName}</span>
      <div>
        <a href="/privacy">Privacy</a>
        <a href="/service-information">Service information</a>
        <a href="/portal/login">Team access</a>
      </div>
    </div>
    <p class="footer-fine">{disclaimer}</p>
  </div>
</footer>
