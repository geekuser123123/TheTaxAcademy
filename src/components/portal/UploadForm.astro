---
import Icon from '../Icon.astro';
import { DOCUMENT_CATEGORIES } from '../../lib/db';

interface Props {
  error?: string;
  withCategory?: boolean;
}

const { error, withCategory = false } = Astro.props;
---

<form method="post" enctype="multipart/form-data" class="stack">
  <input type="hidden" name="action" value="upload" />
  {
    error && (
      <div class="alert alert-error" role="alert">
        <Icon name="circleAlert" size={18} />
        {error}
      </div>
    )
  }
  <div class="field">
    <label for="file">File</label>
    <input id="file" name="file" type="file" required />
    <span class="hint">PDF, images, Word, Excel, and similar. Up to 25 MB.</span>
  </div>
  <div class="field">
    <label for="title">Title <span class="muted">(optional)</span></label>
    <input id="title" name="title" maxlength="200" placeholder="Defaults to the file name" />
  </div>
  {
    withCategory && (
      <div class="field">
        <label for="category">Category</label>
        <select id="category" name="category">
          {DOCUMENT_CATEGORIES.map((c) => (
            <option selected={c === 'Plan documents'}>{c}</option>
          ))}
        </select>
      </div>
    )
  }
  <div>
    <button class="button" type="submit"><Icon name="upload" size={17} />Upload</button>
  </div>
</form>
