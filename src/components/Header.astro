---
import Icon from './Icon.astro';
import { site, mainNav } from '../data/site';

interface Props {
  /** Float the header over a full-bleed hero image (home page). */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => !href.includes('#') && path.startsWith(href);
---

<header class:list={['header', { 'header-overlay': overlay }]}>
  <div class="container">
    <a href="/" class="brand" aria-label={`${site.name} home`}>
      <img src="/images/logo-lockup.webp" alt={site.legalName} width="440" height="362" />
    </a>
    <nav class="nav" aria-label="Main navigation">
      {
        mainNav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="header-actions">
      <a href="/renewal-page/" class="button button-sm" aria-current={isActive('/renewal-page/') ? 'page' : undefined}>Renew My Plan</a>
      <a href={site.memberLoginUrl} class="button button-sm button-secondary">
        <Icon name="lockKeyhole" size={14} />Member Login
      </a>
    </div>
    <button class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav">
      <Icon name="menu" size={24} />
    </button>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" data-open="false">
    {mainNav.map((item) => <a href={item.href}>{item.label}</a>)}
    <div class="mobile-actions">
      <a href="/renewal-page/" class="button">Renew My Plan</a>
      <a href={site.memberLoginUrl} class="button button-secondary"><Icon name="lockKeyhole" size={15} />Member Login</a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('mobile-nav');
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    nav?.setAttribute('data-open', String(open));
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  // "How It Works" is an anchor on the home page: close the menu after following it.
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
