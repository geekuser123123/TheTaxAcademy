---
import Icon from './Icon.astro';
import type { Faq } from '../data/faqs';

interface Props {
  items: Faq[];
  eyebrow?: string;
  title: string;
  intro?: string;
  id?: string;
}

const { items, eyebrow = 'Questions', title, intro, id } = Astro.props;
---

<section class="section" id={id}>
  <div class="container faq-grid">
    <div>
      <span class="eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
      {intro && <p class="lede">{intro}</p>}
    </div>
    <div class="faq-list">
      {
        items.map((f) => (
          <details>
            <summary>
              {f.q}
              <Icon name="plus" size={18} />
            </summary>
            {f.a.map((p) => (
              <p>{p}</p>
            ))}
          </details>
        ))
      }
    </div>
  </div>
</section>
