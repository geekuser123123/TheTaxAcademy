---
import Icon from './Icon.astro';
import type { RequestForm } from '../data/forms';

interface Props {
  form: RequestForm;
}

const { form } = Astro.props;
---

<a href={`/forms/${form.slug}`} class="form-row">
  <span class="icon-box"><Icon name="fileText" size={21} stroke={1.5} /></span>
  <span><strong>{form.title}</strong><small>{form.summary}</small></span>
  <span class="row-time"><Icon name="clock" size={13} />{form.minutes} min</span>
  <Icon name="chevronRight" size={19} />
</a>
